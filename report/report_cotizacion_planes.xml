<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- ============================================= -->
    <!-- Acción de Reporte: Cotización con Planes      -->
    <!-- ============================================= -->
    <record id="action_report_cotizacion_planes" model="ir.actions.report">
        <field name="name">Cotización con Planes de Pago</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">cotizador.report_cotizacion_planes_document</field>
        <field name="report_file">cotizador.report_cotizacion_planes_document</field>
        <field name="print_report_name">'Cotización Planes - %s' % (object.name)</field>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_type">report</field>
    </record>

    <!-- ============================================= -->
    <!-- Template QWeb del Reporte                     -->
    <!-- ============================================= -->
    <template id="report_cotizacion_planes_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <t t-set="doc" t-value="doc.with_context(lang=doc.partner_id.lang)"/>
                    <t t-set="address">
                        <div t-field="doc.partner_id" class="mb-0"
                            t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": True}'/>
                        <p t-if="doc.partner_id.vat" class="mb-0">
                            CUIT: <span t-field="doc.partner_id.vat"/>
                        </p>
                    </t>

                    <div class="page">
                        <!-- Título -->
                        <h2 class="mt-4">
                            <span t-if="doc.state in ['draft','sent']">Cotización # </span>
                            <span t-else="">Orden # </span>
                            <span t-field="doc.name"/>
                        </h2>

                        <!-- Datos de la Cotización -->
                        <div class="row mb-4 mt-4" id="informations">
                            <div t-if="doc.date_order" class="col" name="informations_date">
                                <strong>Fecha</strong>
                                <div t-field="doc.date_order" t-options='{"widget": "date"}'/>
                            </div>
                            <div t-if="doc.validity_date and doc.state in ['draft', 'sent']" class="col">
                                <strong>Vencimiento</strong>
                                <div t-field="doc.validity_date"/>
                            </div>
                            <div t-if="doc.user_id.name" class="col">
                                <strong>Vendedor</strong>
                                <div t-field="doc.user_id"/>
                            </div>
                        </div>

                        <!-- ======================================= -->
                        <!-- Descripción de la Configuración         -->
                        <!-- ======================================= -->
                        <t t-set="config_descriptions" t-value="[]"/>
                        <t t-foreach="doc.order_line.filtered(lambda l: l.product_id and l.product_id.product_tmpl_id.categ_id.name == 'Maquina')" t-as="maquina_line">
                            <t t-set="config_rel" t-value="doc.env['sembradora.config.rel'].search([
                                ('modelo_id', '=', maquina_line.product_id.product_tmpl_id.id),
                                ('value_ids', 'in', maquina_line.product_id.product_template_attribute_value_ids.mapped('product_attribute_value_id').ids)
                            ], limit=1)"/>
                            <t t-if="config_rel and config_rel.description">
                                <div class="mb-4 p-3" style="background-color: #f8f9fa; border-left: 4px solid #495057;">
                                    <h4 class="mb-2">
                                        <i class="fa fa-info-circle"/> Descripción — <span t-out="config_rel.name"/>
                                    </h4>
                                    <div t-field="config_rel.description"/>
                                </div>
                            </t>
                        </t>

                        <!-- ======================================= -->
                        <!-- Tabla de Líneas de la Cotización         -->
                        <!-- ======================================= -->
                        <t t-set="lines_to_report" t-value="doc.order_line.filtered(lambda l: not l.is_plan_pago)"/>
                        <table class="table table-sm o_main_table table-borderless mt-4">
                            <thead style="display: table-row-group">
                                <tr>
                                    <th class="text-start">Descripción</th>
                                    <th class="text-end">Cantidad</th>
                                    <th class="text-end">Precio Unitario</th>
                                    <th class="text-end">Subtotal</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="lines_to_report" t-as="line">
                                    <tr t-if="line.display_type == 'line_section'" class="o_line_section">
                                        <td colspan="4" class="fw-bold">
                                            <span t-field="line.name"/>
                                        </td>
                                    </tr>
                                    <tr t-if="line.display_type == 'line_note'" class="o_line_note">
                                        <td colspan="4" class="fst-italic">
                                            <span t-field="line.name"/>
                                        </td>
                                    </tr>
                                    <tr t-if="not line.display_type">
                                        <td>
                                            <span t-field="line.name"/>
                                        </td>
                                        <td class="text-end">
                                            <span t-field="line.product_uom_qty"/>
                                        </td>
                                        <td class="text-end">
                                            <span t-field="line.price_unit"
                                                  t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                        </td>
                                        <td class="text-end">
                                            <span t-field="line.price_subtotal"
                                                  t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <!-- Totales -->
                        <div class="row mt-3" style="page-break-inside: avoid;">
                            <div class="col-5 ms-auto">
                                <table class="table table-sm">
                                    <tr>
                                        <td class="fw-bold">Subtotal sin impuestos</td>
                                        <td class="text-end">
                                            <span t-field="doc.amount_untaxed"
                                                  t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>Impuestos</td>
                                        <td class="text-end">
                                            <span t-field="doc.amount_tax"
                                                  t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                        </td>
                                    </tr>
                                    <tr class="border-top">
                                        <td class="fw-bold">Total</td>
                                        <td class="text-end fw-bold">
                                            <span t-field="doc.amount_total"
                                                  t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <!-- ======================================= -->
                        <!-- Planes de Pago Disponibles               -->
                        <!-- ======================================= -->
                        <t t-set="plan_templates" t-value="doc.env['cotizador.plan.pago.template'].search([('active', '=', True)])"/>
                        <t t-if="plan_templates">
                            <div class="mt-5" style="page-break-inside: avoid;">
                                <h3><i class="fa fa-money"/> Planes de Pago Disponibles</h3>
                                <hr class="mt-0 mb-3"/>

                                <t t-foreach="plan_templates" t-as="plan_tmpl">
                                    <h5 class="mt-4 mb-2 fw-bold text-dark">
                                        <span t-field="plan_tmpl.name"/>
                                    </h5>

                                    <!-- Canje Cereal -->
                                    <t t-if="plan_tmpl.tipo == 'canje_cereal'">
                                        <table class="table table-sm o_main_table table-borderless mt-2 mb-4">
                                            <thead style="display: table-row-group">
                                                <tr>
                                                    <th class="text-start">Opción</th>
                                                    <th class="text-start">Entrega</th>
                                                    <th class="text-start">Condición</th>
                                                    <th class="text-end">Desc. / Rec.</th>
                                                    <th class="text-end">Total Estimado</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <t t-foreach="plan_tmpl.line_ids" t-as="pl">
                                                    <tr>
                                                        <td class="text-start"><span t-field="pl.opcion"/></td>
                                                        <td class="text-start"><span t-field="pl.entrega_canje"/></td>
                                                        <td class="text-start"><span t-field="pl.condicion"/></td>
                                                        <td class="text-end">
                                                            <span t-field="pl.descuento"/>%
                                                        </td>
                                                        <td class="text-end fw-bold">
                                                            <span t-out="doc.amount_total * (1 + pl.descuento / 100)"
                                                                  t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                                        </td>
                                                    </tr>
                                                </t>
                                            </tbody>
                                        </table>
                                    </t>

                                    <!-- Cheques -->
                                    <t t-if="plan_tmpl.tipo == 'cheques'">
                                        <table class="table table-sm o_main_table table-borderless mt-2 mb-4">
                                            <thead style="display: table-row-group">
                                                <tr>
                                                    <th class="text-start">Plan</th>
                                                    <th class="text-end">Promedio Días</th>
                                                    <th class="text-start">Cheques</th>
                                                    <th class="text-end">Desc. / Rec.</th>
                                                    <th class="text-end">Total Estimado</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <t t-foreach="plan_tmpl.line_ids" t-as="pl">
                                                    <tr>
                                                        <td class="text-start"><span t-field="pl.plan_cheques"/></td>
                                                        <td class="text-end"><span t-field="pl.promedio_dias"/></td>
                                                        <td class="text-start"><span t-field="pl.cheques_desc"/></td>
                                                        <td class="text-end">
                                                            <span t-field="pl.descuento"/>%
                                                        </td>
                                                        <td class="text-end fw-bold">
                                                            <span t-out="doc.amount_total * (1 + pl.descuento / 100)"
                                                                  t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                                        </td>
                                                    </tr>
                                                </t>
                                            </tbody>
                                        </table>
                                    </t>

                                    <!-- Documentos -->
                                    <t t-if="plan_tmpl.tipo == 'documentos'">
                                        <table class="table table-sm o_main_table table-borderless mt-2 mb-4">
                                            <thead style="display: table-row-group">
                                                <tr>
                                                    <th class="text-start">Plan</th>
                                                    <th class="text-start">Entrega</th>
                                                    <th class="text-start">Saldo</th>
                                                    <th class="text-end">Desc. / Rec.</th>
                                                    <th class="text-end">Total Estimado</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <t t-foreach="plan_tmpl.line_ids" t-as="pl">
                                                    <tr>
                                                        <td class="text-start"><span t-field="pl.plan_documentos"/></td>
                                                        <td class="text-start"><span t-field="pl.entrega_pct"/></td>
                                                        <td class="text-start"><span t-field="pl.saldo"/></td>
                                                        <td class="text-end">
                                                            <span t-field="pl.descuento"/>%
                                                        </td>
                                                        <td class="text-end fw-bold">
                                                            <span t-out="doc.amount_total * (1 + pl.descuento / 100)"
                                                                  t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                                        </td>
                                                    </tr>
                                                </t>
                                            </tbody>
                                        </table>
                                    </t>

                                    <!-- Crédito Bancario -->
                                    <t t-if="plan_tmpl.tipo == 'credito_bancario'">
                                        <table class="table table-sm o_main_table table-borderless mt-2 mb-4">
                                            <thead style="display: table-row-group">
                                                <tr>
                                                    <th class="text-start">Banco / Línea</th>
                                                    <th class="text-start">Plazo / Tasa</th>
                                                    <th class="text-start">Financiación</th>
                                                    <th class="text-end">Desc. / Rec.</th>
                                                    <th class="text-end">Total Estimado</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <t t-foreach="plan_tmpl.line_ids" t-as="pl">
                                                    <tr>
                                                        <td class="text-start"><span t-field="pl.banco_linea"/></td>
                                                        <td class="text-start"><span t-field="pl.plazo_tasa"/></td>
                                                        <td class="text-start"><span t-field="pl.financiacion"/></td>
                                                        <td class="text-end">
                                                            <span t-field="pl.descuento"/>%
                                                        </td>
                                                        <td class="text-end fw-bold">
                                                            <span t-out="doc.amount_total * (1 + pl.descuento / 100)"
                                                                  t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                                        </td>
                                                    </tr>
                                                </t>
                                            </tbody>
                                        </table>
                                    </t>
                                </t>
                            </div>
                        </t>

                        <!-- Términos y Condiciones -->
                        <t t-if="not is_html_empty(doc.note)">
                            <div class="mt-4">
                                <h4>Términos y Condiciones</h4>
                                <hr class="mt-0 mb-1"/>
                                <em t-field="doc.note"/>
                            </div>
                        </t>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
