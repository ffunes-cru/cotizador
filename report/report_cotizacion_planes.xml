<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- ============================================= -->
    <!-- Formato de Papel A4 Optimizado               -->
    <!-- ============================================= -->
    <record id="paperformat_cotizacion_compacta" model="report.paperformat">
        <field name="name">Cotización Planes Compacto (A4)</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">10</field>
        <field name="margin_bottom">10</field>
        <field name="margin_left">10</field>
        <field name="margin_right">10</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <!-- ============================================= -->
    <!-- Acción de Reporte: Cotización con Planes      -->
    <!-- ============================================= -->
    <record id="action_report_cotizacion_planes" model="ir.actions.report">
        <field name="name">Cotización con Planes de Pago</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">cotizador.report_cotizacion_planes_document</field>
        <field name="report_file">cotizador.report_cotizacion_planes_document</field>
        <field name="print_report_name">'Cotización - %s' % (object.name)</field>
        <field name="paperformat_id" ref="paperformat_cotizacion_compacta"/>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_type">report</field>
    </record>

    <!-- Redirección del reporte nativo de Odoo sale.action_report_saleorder a nuestro diseño con planes -->
    <record id="sale.action_report_saleorder" model="ir.actions.report">
        <field name="report_name">cotizador.report_cotizacion_planes_document</field>
        <field name="report_file">cotizador.report_cotizacion_planes_document</field>
        <field name="paperformat_id" ref="paperformat_cotizacion_compacta"/>
    </record>

    <!-- ============================================= -->
    <!-- Template QWeb del Reporte                     -->
    <!-- ============================================= -->
    <template id="report_cotizacion_planes_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.basic_layout">
                    <t t-set="doc" t-value="doc.with_context(lang=doc.partner_id.lang)"/>

                    <div class="page" style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: 14px; color: #212529; padding-top: 0 !important; margin-top: 0 !important;">
                        <style>
                            .page {
                                padding-top: 0px !important;
                                margin-top: 0px !important;
                            }
                            .meta-label {
                                color: #a73c3e !important;
                                font-size: 13px;
                                font-weight: 700;
                                margin-bottom: 2px;
                            }
                            .meta-val {
                                color: #111111;
                                font-weight: 600;
                                font-size: 14px;
                            }
                            .o_line_section td {
                                background-color: #f1f3f5 !important;
                                color: #111111 !important;
                                font-weight: 700;
                                font-size: 15px;
                                padding: 6px 8px !important;
                            }
                            /* Descripción Técnica: Ajuste compacto para entrar completa en una hoja */
                            .config-rich-description {
                                width: 100% !important;
                                color: #212529 !important;
                            }
                            .config-rich-description * {
                                box-sizing: border-box !important;
                            }
                            .config-rich-description table {
                                width: 100% !important;
                                max-width: 100% !important;
                                margin-top: 3px !important;
                                margin-bottom: 3px !important;
                                border-collapse: collapse !important;
                                border: 1px solid #ced4da !important;
                                table-layout: auto !important;
                                height: auto !important;
                            }
                            .config-rich-description tr {
                                height: auto !important;
                                page-break-inside: avoid !important;
                            }
                            .config-rich-description th, .config-rich-description td {
                                padding: 2px 5px !important;
                                border: 1px solid #ced4da !important;
                                vertical-align: middle !important;
                                font-size: 10.5px !important;
                                line-height: 1.15 !important;
                                height: auto !important;
                                min-height: 0 !important;
                            }
                            .config-rich-description th {
                                background-color: #f1f3f5 !important;
                                font-weight: 700 !important;
                                color: #111111 !important;
                            }
                            .config-rich-description p, 
                            .config-rich-description div, 
                            .config-rich-description span {
                                margin-top: 1px !important;
                                margin-bottom: 1px !important;
                                padding: 0 !important;
                                font-size: 10.5px !important;
                                line-height: 1.2 !important;
                            }
                            .config-rich-description h1, 
                            .config-rich-description h2, 
                            .config-rich-description h3, 
                            .config-rich-description h4,
                            .config-rich-description h5 {
                                font-size: 12px !important;
                                font-weight: 700 !important;
                                margin-top: 4px !important;
                                margin-bottom: 2px !important;
                                line-height: 1.2 !important;
                                color: #111111 !important;
                            }
                            .config-rich-description ul, 
                            .config-rich-description ol {
                                margin-top: 1px !important;
                                margin-bottom: 1px !important;
                                padding-left: 18px !important;
                            }
                            .config-rich-description li {
                                font-size: 10.5px !important;
                                line-height: 1.2 !important;
                                margin: 0 !important;
                                padding: 0 !important;
                            }
                            .config-rich-description img {
                                max-width: 100% !important;
                                max-height: 160px !important;
                                height: auto !important;
                            }
                        </style>

                        <!-- ============================================= -->
                        <!-- PÁGINA 1: Encabezado, Metadatos, Líneas,      -->
                        <!-- Totales y Descripción (si cabe)               -->
                        <!-- ============================================= -->

                        <!-- ENCABEZADO SUPERIOR: Crucianelli + Slogan | Concesionario (MAQUETADO CON DIVS SIN BORDES) -->
                        <div style="width: 100%; margin-bottom: 14px; clear: both; overflow: hidden;">
                            <!-- Columna Izquierda: Logo Crucianelli y Slogan -->
                            <div style="float: left; width: 50%; text-align: left;">
                                <div style="display: inline-block;">
                                    <img t-if="doc.company_id.logo" 
                                         t-att-src="image_data_uri(doc.company_id.logo)" 
                                         style="max-height: 55px; max-width: 250px; object-fit: contain;" 
                                         alt="Crucianelli"/>
                                    <div style="color: #c0282d; font-weight: 700; font-size: 13px; margin-top: 3px; line-height: 1.2;">
                                        <t t-if="doc.company_id.report_header">
                                            <span t-out="doc.company_id.report_header"/>
                                        </t>
                                        <t t-else="">
                                            Somos la tecnología que te hace crecer
                                        </t>
                                    </div>
                                </div>
                            </div>

                            <!-- Columna Derecha: Logo y Nombre del Concesionario -->
                            <div style="float: right; width: 50%; text-align: right;">
                                <t t-set="concesionario_partner" t-value="doc.user_id.partner_id"/>
                                <t t-set="concesionario_empresa" t-value="concesionario_partner.parent_id if (concesionario_partner and concesionario_partner.parent_id) else False"/>
                                <t t-set="concesionario_img" t-value="(concesionario_empresa and concesionario_empresa.image_1920) or (concesionario_partner and concesionario_partner.image_1920) or doc.user_id.image_1920"/>

                                <div t-if="concesionario_img" style="margin-bottom: 4px;">
                                    <img t-att-src="image_data_uri(concesionario_img)" 
                                         style="max-height: 50px; max-width: 220px; object-fit: contain;" 
                                         alt="Logo Concesionario"/>
                                </div>
                                <div style="font-size: 15px; font-weight: 800; color: #111111; text-transform: uppercase; letter-spacing: 0.3px;">
                                    <span t-if="concesionario_empresa" t-field="concesionario_empresa.name"/>
                                    <span t-elif="doc.user_id" t-field="doc.user_id.name"/>
                                </div>
                                <div t-if="doc.user_id.partner_id.phone or doc.user_id.email" style="font-size: 12px; color: #555555; margin-top: 2px;">
                                    <span t-if="doc.user_id.partner_id.phone" t-field="doc.user_id.partner_id.phone"/>
                                    <span t-if="doc.user_id.partner_id.phone and doc.user_id.email"> | </span>
                                    <span t-if="doc.user_id.email" t-field="doc.user_id.email"/>
                                </div>
                            </div>
                        </div>

                        <!-- TÍTULO DE COTIZACIÓN (EN ROJO CRUCIANELLI) -->
                        <div style="margin-top: 6px; margin-bottom: 12px; clear: both;">
                            <h2 style="color: #c0282d; font-size: 24px; font-weight: 700; margin: 0; padding: 0; letter-spacing: -0.5px;">
                                Número de cotización <span t-field="doc.name"/>
                            </h2>
                        </div>

                        <!-- BLOQUE DE METADATOS Y CLIENTE (MAQUETADO CON DIVS, SIN TABLAS NI BORDES) -->
                        <div style="width: 100%; margin-bottom: 16px; clear: both; overflow: hidden;">
                            <!-- Metadatos a la Izquierda (60% del ancho) -->
                            <div style="float: left; width: 60%;">
                                <!-- Columna 1: Vencimiento y Vendedor -->
                                <div style="float: left; width: 48%; padding-right: 10px;">
                                    <div style="margin-bottom: 8px;">
                                        <div class="meta-label">Vencimiento</div>
                                        <div class="meta-val">
                                            <span t-if="doc.validity_date" t-field="doc.validity_date"/>
                                            <span t-else="">-</span>
                                        </div>
                                    </div>
                                    <div>
                                        <div class="meta-label">Vendedor</div>
                                        <div class="meta-val">
                                            <span t-field="doc.user_id.name"/>
                                        </div>
                                    </div>
                                </div>

                                <!-- Columna 2: Fecha y Líder Equipo -->
                                <div style="float: left; width: 48%; padding-right: 10px;">
                                    <div style="margin-bottom: 8px;">
                                        <div class="meta-label">Fecha de cotización</div>
                                        <div class="meta-val">
                                            <span t-if="doc.date_order" t-field="doc.date_order" t-options='{"widget": "date"}'/>
                                            <span t-else="">-</span>
                                        </div>
                                    </div>
                                    <div>
                                        <div class="meta-label">LIDER EQUIPO</div>
                                        <div class="meta-val">
                                            <span t-if="doc.team_id and doc.team_id.user_id" t-field="doc.team_id.user_id.name"/>
                                            <span t-else="" t-field="doc.user_id.name"/>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Columna 3: Datos del Cliente (40% del ancho, a la derecha) -->
                            <div style="float: right; width: 38%; text-align: right;">
                                <div style="font-size: 15px; font-weight: 700; color: #111111; margin-bottom: 2px;">
                                    <span t-field="doc.partner_id.name"/>
                                </div>
                                <div style="font-size: 13.5px; color: #444444; line-height: 1.35;">
                                    <div t-if="doc.partner_id.street"><span t-field="doc.partner_id.street"/></div>
                                    <div>
                                        <span t-if="doc.partner_id.city"><span t-field="doc.partner_id.city"/></span>
                                        <span t-if="doc.partner_id.zip"> <span t-field="doc.partner_id.zip"/></span>
                                    </div>
                                    <div t-if="doc.partner_id.vat" style="margin-top: 2px;">
                                        <strong>CUIT:</strong> <span t-field="doc.partner_id.vat"/>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- TABLA DE LÍNEAS DE LA COTIZACIÓN (CON TAMAÑO DE FUENTE MÁS GRANDE) -->
                        <t t-set="lines_to_report" t-value="doc.order_line.filtered(lambda l: not l.is_plan_pago)"/>
                        <table class="table o_main_table table-borderless mt-2 mb-2" style="font-size: 15px; width: 100%;">
                            <thead style="border-bottom: 2px solid #212529;">
                                <tr>
                                    <th class="text-start" style="font-weight: 700; color: #212529; padding: 6px 8px; font-size: 15px; width: 48%;">Descripción</th>
                                    <th class="text-center" style="font-weight: 700; color: #212529; padding: 6px 8px; font-size: 15px; width: 14%;">Cantidad</th>
                                    <th class="text-end" style="font-weight: 700; color: #212529; padding: 6px 8px; font-size: 15px; width: 19%;">Precio Unitario</th>
                                    <th class="text-end" style="font-weight: 700; color: #212529; padding: 6px 8px; font-size: 15px; width: 19%;">Subtotal</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="lines_to_report" t-as="line">
                                    <tr t-if="line.display_type == 'line_section'" class="o_line_section">
                                        <td colspan="4" class="fw-bold py-2 px-2" style="background-color: #f1f3f5 !important; color: #111111 !important; font-size: 15px;">
                                            <span t-field="line.name"/>
                                        </td>
                                    </tr>
                                    <tr t-if="line.display_type == 'line_note'">
                                        <td colspan="4" class="fst-italic text-muted py-1 px-2" style="font-size: 14px;">
                                            <span t-field="line.name"/>
                                        </td>
                                    </tr>
                                    <tr t-if="not line.display_type" style="border-bottom: 1px solid #e9ecef;">
                                        <!-- Descripción con tamaño de letra más grande y renglones compactos -->
                                        <td class="py-2 px-2" style="color: #111111; vertical-align: top;">
                                            <t t-set="name_parts" t-value="line.name.split('\n') if line.name else []"/>
                                            <t t-if="name_parts">
                                                <div style="font-weight: 700; font-size: 16px; color: #111111; margin-bottom: 3px;">
                                                    <span t-out="name_parts[0]"/>
                                                </div>
                                                <div t-if="len(name_parts) &gt; 1" style="color: #212529; font-size: 14.5px; line-height: 1.35;">
                                                    <t t-foreach="name_parts[1:]" t-as="subline">
                                                        <div t-if="subline.strip()" style="margin: 0; padding: 1.5px 0;">
                                                            <span t-out="subline"/>
                                                        </div>
                                                    </t>
                                                </div>
                                            </t>
                                        </td>
                                        <td class="text-center py-2 px-2" style="color: #212529; vertical-align: top; font-size: 15px;">
                                            <span t-options='{"widget": "float", "precision": 2}' t-field="line.product_uom_qty"/>
                                        </td>
                                        <td class="text-end py-2 px-2" style="color: #212529; vertical-align: top; font-size: 15px;">
                                            <span t-field="line.price_unit" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                        </td>
                                        <td class="text-end fw-bold py-2 px-2" style="color: #111111; vertical-align: top; font-size: 15.5px;">
                                            <span t-field="line.price_subtotal" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <!-- TOTALES Y TÉRMINOS (MAQUETADO CON DIVS SIN BORDES EXTERNOS) -->
                        <div style="width: 100%; margin-top: 10px; margin-bottom: 15px; clear: both; overflow: hidden;">
                            <!-- Izquierda: Notas y Términos de Pago -->
                            <div style="float: left; width: 50%; padding-right: 20px;">
                                <div t-if="doc.note and not is_html_empty(doc.note)" style="font-size: 13.5px; color: #333333; margin-bottom: 6px;">
                                    <div t-field="doc.note"/>
                                </div>
                                <div t-if="doc.payment_term_id" style="font-size: 14px; color: #333333;">
                                    <strong>Términos de pago:</strong> <span t-field="doc.payment_term_id.name"/>
                                </div>
                            </div>

                            <!-- Derecha: Cuadro de Totales -->
                            <div style="float: right; width: 48%;">
                                <table class="table table-sm table-borderless" style="width: 100%; font-size: 14.5px; margin: 0; border: none !important;">
                                    <tbody>
                                        <tr style="background-color: #f8f9fa;">
                                            <td class="text-start py-1 px-3" style="color: #333333; font-weight: 600;">Subtotal sin impuestos</td>
                                            <td class="text-end py-1 px-3" style="color: #111111; font-weight: 700;">
                                                <span t-field="doc.amount_untaxed" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td class="text-start py-1 px-3" style="color: #333333; font-weight: 600;">Impuestos</td>
                                            <td class="text-end py-1 px-3" style="color: #111111; font-weight: 700;">
                                                <span t-field="doc.amount_tax" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                            </td>
                                        </tr>
                                        <tr style="border-top: 2px solid #222222; background-color: #f1f3f5;">
                                            <td class="text-start py-2 px-3 fs-6" style="color: #000000; font-weight: 800;">Total</td>
                                            <td class="text-end py-2 px-3 fs-6" style="color: #000000; font-weight: 800;">
                                                <span t-field="doc.amount_total" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <!-- ============================================= -->
                        <!-- PÁGINA DEDICADA: DESCRIPCIÓN TÉCNICA          -->
                        <!-- ============================================= -->
                        <t t-foreach="doc.order_line.filtered(lambda l: l.product_id and l.product_id.product_tmpl_id.categ_id.name == 'Maquina')" t-as="maquina_line">
                            <t t-set="attr_ids" t-value="maquina_line.product_id.product_template_attribute_value_ids.mapped('product_attribute_value_id').ids"/>
                            <t t-set="configs" t-value="doc.env['sembradora.config.rel'].search([('modelo_id', '=', maquina_line.product_id.product_tmpl_id.id)])"/>
                            <t t-set="config_match" t-value="configs.filtered(lambda c: set(c.value_ids.ids) == set(attr_ids))"/>
                            <t t-set="desc_content" t-value="(config_match and config_match[0].description) or maquina_line.product_id.product_tmpl_id.get_config_description(maquina_line.product_id.product_template_attribute_value_ids.mapped('product_attribute_value_id')) or maquina_line.product_id.description_sale or maquina_line.product_id.product_tmpl_id.description_sale"/>
                            
                            <t t-if="desc_content">
                                <div style="page-break-before: always; page-break-inside: avoid !important; clear: both;" class="pt-2">
                                    <!-- Encabezado de la página de especificaciones -->
                                    <div style="width: 100%; border-bottom: 2px solid #c0282d; margin-bottom: 8px; padding-bottom: 3px; clear: both; overflow: hidden;">
                                        <div style="float: left;">
                                            <h3 class="fw-bold mb-0" style="color: #c0282d; font-size: 17px; margin: 0; line-height: 22px;">
                                                Descripción Técnica — <span t-field="maquina_line.product_id.name"/>
                                            </h3>
                                        </div>
                                        <div style="float: right; color: #6c757d; font-size: 12px; line-height: 22px;">
                                            Cotización <span t-field="doc.name"/>
                                        </div>
                                    </div>
                                    <div class="config-rich-description">
                                        <div t-out="desc_content"/>
                                    </div>
                                </div>
                            </t>
                        </t>

                        <!-- ============================================= -->
                        <!-- HOJA COMPLETA DEDICADA: PLANES DE PAGO        -->
                        <!-- ============================================= -->
                        <t t-set="plan_templates" t-value="doc.env['cotizador.plan.pago.template'].search([('active', '=', True)])"/>
                        <t t-if="plan_templates">
                            <div style="page-break-before: always; page-break-inside: avoid !important; clear: both;" class="pt-2">
                                <div style="width: 100%; border-bottom: 2px solid #c0282d; margin-bottom: 12px; padding-bottom: 4px; clear: both; overflow: hidden;">
                                    <div style="float: left;">
                                        <h3 class="fw-bold mb-0" style="color: #c0282d; font-size: 22px; margin: 0;">
                                            Planes de Pago Disponibles
                                        </h3>
                                    </div>
                                    <div style="float: right; color: #6c757d; font-size: 13px; line-height: 28px;">
                                        Cotización <span t-field="doc.name"/>
                                    </div>
                                </div>

                                <t t-foreach="plan_templates" t-as="plan_tmpl">
                                    <div class="mb-3" style="page-break-inside: avoid;">
                                        <h5 class="mt-2 mb-1 fw-bold text-dark" style="font-size: 14.5px; color: #111111 !important;">
                                            <span t-field="plan_tmpl.name"/>
                                        </h5>

                                        <!-- Canje Cereal -->
                                        <t t-if="plan_tmpl.tipo == 'canje_cereal'">
                                            <table class="table table-sm table-borderless mb-2" style="font-size: 13px;">
                                                <thead style="border-bottom: 2px solid #495057;">
                                                    <tr>
                                                        <th class="text-start" style="color: #212529 !important; font-weight: 700; font-size: 12px; padding: 4px 6px;">OPCIÓN</th>
                                                        <th class="text-start" style="color: #212529 !important; font-weight: 700; font-size: 12px; padding: 4px 6px;">ENTREGA</th>
                                                        <th class="text-start" style="color: #212529 !important; font-weight: 700; font-size: 12px; padding: 4px 6px;">CONDICIÓN</th>
                                                        <th class="text-end" style="color: #212529 !important; font-weight: 700; font-size: 12px; padding: 4px 6px;">DESC. / REC.</th>
                                                        <th class="text-end" style="color: #212529 !important; font-weight: 700; font-size: 12px; padding: 4px 6px;">TOTAL ESTIMADO</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <t t-foreach="plan_tmpl.line_ids" t-as="pl">
                                                        <tr style="border-bottom: 1px solid #dee2e6; color: #212529;">
                                                            <td class="text-start" style="padding: 4px 6px;"><span t-field="pl.opcion"/></td>
                                                            <td class="text-start" style="padding: 4px 6px;"><span t-field="pl.entrega_canje"/></td>
                                                            <td class="text-start" style="padding: 4px 6px;"><span t-field="pl.condicion"/></td>
                                                            <td class="text-end fw-semibold" style="padding: 4px 6px;">
                                                                <span t-field="pl.descuento"/>%
                                                            </td>
                                                            <td class="text-end fw-bold" style="color: #111111; padding: 4px 6px;">
                                                                <span t-out="doc.amount_total * (1 + pl.descuento / 100)"
                                                                      t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                                            </td>
                                                        </tr>
                                                    </t>
                                                </tbody>
                                            </table>
                                        </t>

                                        <!-- Cheques -->
                                        <t t-if="plan_tmpl.tipo == 'cheques'">
                                            <table class="table table-sm table-borderless mb-2" style="font-size: 13px;">
                                                <thead style="border-bottom: 2px solid #495057;">
                                                    <tr>
                                                        <th class="text-start" style="color: #212529 !important; font-weight: 700; font-size: 12px; padding: 4px 6px;">PLAN</th>
