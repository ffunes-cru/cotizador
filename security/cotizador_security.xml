<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_cotizador" model="res.groups.privilege">
        <field name="name">Configurador de Sembradoras</field>
        <field name="sequence">50</field>
        <field name="category_id" ref="base.module_category_sales"/>
    </record>

    <!-- Administra la matriz de ingeniería: configuraciones, precios, accesorios, reglas,
         importador CSV y códigos Teamcenter.
         Los vendedores (base.group_user) solo leen la matriz para cotizar. -->
    <record id="group_cotizador_manager" model="res.groups">
        <field name="name">Administrador del Configurador</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_cotizador"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Puede crear y modificar configuraciones, precios, accesorios y reglas del configurador.</field>
    </record>
</odoo>
