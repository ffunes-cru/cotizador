<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_cotizador" model="res.groups.privilege">
        <field name="name">Configurador de Sembradoras</field>
        <field name="sequence">50</field>
        <field name="category_id" ref="base.module_category_sales"/>
    </record>

    <!-- Administra la matriz de ingeniería: configuraciones, precios, accesorios, reglas,
         importador CSV y códigos Teamcenter.
         Los vendedores (base.group_user) solo leen la matriz para cotizar. -->
    <record id="group_cotizador_manager" model="res.groups">
        <field name="name">Administrador del Configurador</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_cotizador"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Puede crear y modificar configuraciones, precios, accesorios y reglas del configurador.</field>
    </record>

    <!-- Niveles comerciales (issue #1). Los niveles estándar de Ventas siguen valiendo:
         Vendedor = "Usuario: solo sus documentos"; Gerencia = "Usuario: todos los documentos" o "Administrador".
         Cada concesionario es un equipo de ventas: su líder es el usuario del concesionario y sus miembros, los
         vendedores. Las reglas de abajo se suman (OR) a la regla estándar "solo sus documentos". -->
    <record id="res_groups_privilege_nivel_comercial" model="res.groups.privilege">
        <field name="name">Nivel Comercial (Cotizador)</field>
        <field name="sequence">51</field>
        <field name="category_id" ref="base.module_category_sales"/>
        <field name="placeholder">Vendedor (solo lo suyo)</field>
    </record>

    <record id="group_lider_concesionario" model="res.groups">
        <field name="name">Líder de Concesionario</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_nivel_comercial"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
        <field name="comment">Ve y edita todo lo de los equipos de ventas (concesionarios) que lidera.</field>
    </record>

    <record id="group_supervisor_zona" model="res.groups">
        <field name="name">Supervisor de Zona</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_nivel_comercial"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
        <field name="comment">Ve en solo lectura lo de los concesionarios que supervisa; crea sus propias cotizaciones y las asigna a un concesionario.</field>
    </record>

    <!-- Líder: todo lo de sus equipos, con todos los permisos -->
    <record id="rule_lider_sale_order" model="ir.rule">
        <field name="name">Cotizador: cotizaciones de los equipos que lidera</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="domain_force">[('team_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_lider_concesionario'))]"/>
    </record>
    <record id="rule_lider_sale_order_line" model="ir.rule">
        <field name="name">Cotizador: líneas de los equipos que lidera</field>
        <field name="model_id" ref="sale.model_sale_order_line"/>
        <field name="domain_force">[('order_id.team_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_lider_concesionario'))]"/>
    </record>
    <record id="rule_lider_sale_report" model="ir.rule">
        <field name="name">Cotizador: análisis de ventas de los equipos que lidera</field>
        <field name="model_id" ref="sale.model_sale_report"/>
        <field name="domain_force">[('team_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_lider_concesionario'))]"/>
    </record>
    <record id="rule_lider_crm_lead" model="ir.rule">
        <field name="name">Cotizador: oportunidades de los equipos que lidera</field>
        <field name="model_id" ref="crm.model_crm_lead"/>
        <field name="domain_force">[('team_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_lider_concesionario'))]"/>
    </record>
    <record id="rule_lider_crm_activity_report" model="ir.rule">
        <field name="name">Cotizador: actividades de los equipos que lidera</field>
        <field name="model_id" ref="crm.model_crm_activity_report"/>
        <field name="domain_force">[('team_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_lider_concesionario'))]"/>
    </record>

    <!-- Supervisor: solo lectura de los equipos que supervisa. Escribe solo lo suyo (regla estándar). -->
    <record id="rule_supervisor_sale_order" model="ir.rule">
        <field name="name">Cotizador: cotizaciones de los equipos que supervisa (lectura)</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="domain_force">[('team_id.cotizador_supervisor_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_supervisor_zona'))]"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_supervisor_sale_order_line" model="ir.rule">
        <field name="name">Cotizador: líneas de los equipos que supervisa (lectura)</field>
        <field name="model_id" ref="sale.model_sale_order_line"/>
        <field name="domain_force">[('order_id.team_id.cotizador_supervisor_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_supervisor_zona'))]"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_supervisor_sale_report" model="ir.rule">
        <field name="name">Cotizador: análisis de ventas de los equipos que supervisa</field>
        <field name="model_id" ref="sale.model_sale_report"/>
        <field name="domain_force">[('team_id.cotizador_supervisor_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_supervisor_zona'))]"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_supervisor_crm_lead" model="ir.rule">
        <field name="name">Cotizador: oportunidades de los equipos que supervisa (lectura)</field>
        <field name="model_id" ref="crm.model_crm_lead"/>
        <field name="domain_force">[('team_id.cotizador_supervisor_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_supervisor_zona'))]"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_supervisor_crm_activity_report" model="ir.rule">
        <field name="name">Cotizador: actividades de los equipos que supervisa</field>
        <field name="model_id" ref="crm.model_crm_activity_report"/>
        <field name="domain_force">[('team_id.cotizador_supervisor_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_supervisor_zona'))]"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- ================================================================================================
         Usuarios externos (concesionarios y sus vendedores): usuarios internos que no son de Crucianelli.
         Ven solo los clientes de su concesionario, nada sin vendedor y ninguna cuenta bancaria (auditoría de
         seguridad 11/2026; models/res_partner.py y models/res_users.py).

         Las reglas son GLOBALES (sin grupo): las reglas por grupo se suman (OR) a las estándar de Odoo y no podrían
         restringir. Para los demás usuarios su dominio es [(1, '=', 1)]: no cambian nada.
         ================================================================================================ -->
    <record id="res_groups_privilege_origen_usuario" model="res.groups.privilege">
        <field name="name">Origen del Usuario (Cotizador)</field>
        <field name="sequence">52</field>
        <field name="category_id" ref="base.module_category_sales"/>
        <field name="placeholder">Personal de Crucianelli</field>
    </record>

    <record id="group_usuario_externo" model="res.groups">
        <field name="name">Usuario externo (concesionario)</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_origen_usuario"/>
        <field name="comment">Ve solo los clientes de su concesionario y las cotizaciones con vendedor. Se asigna solo a los usuarios internos cuyo correo no es de Crucianelli (parámetro cotizador.dominios_internos).</field>
    </record>

    <record id="rule_externo_res_partner" model="ir.rule">
        <field name="name">Cotizador: un usuario externo ve los clientes de su concesionario</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <!-- Además: personal y usuarios internos (aparecen como vendedor o seguidor), la empresa, su propia empresa
             y lo que él creó. El concesionario va en el contacto comercial: los contactos hijos lo heredan. -->
        <field name="domain_force">[(1, '=', 1)] if not user.has_group('cotizador.group_usuario_externo') else [
            '|', '|', '|', '|', '|',
            ('partner_share', '=', False),
            ('id', 'in', user.company_ids.partner_id.ids),
            ('id', 'child_of', user.partner_id.commercial_partner_id.id),
            ('create_uid', '=', user.id),
            ('commercial_partner_id.cotizador_concesionario_ids.user_id', '=', user.id),
            ('commercial_partner_id.cotizador_concesionario_ids.crm_team_member_ids.user_id', '=', user.id)]</field>
    </record>

    <record id="rule_externo_res_partner_bank" model="ir.rule">
        <field name="name">Cotizador: un usuario externo no ve cuentas bancarias</field>
        <field name="model_id" ref="base.model_res_partner_bank"/>
        <field name="domain_force">[(1, '=', 1)] if not user.has_group('cotizador.group_usuario_externo') else [(0, '=', 1)]</field>
    </record>

    <!-- Conversaciones y Calendario (issue #23): un externo no lee los canales públicos ni las reuniones del personal.
         Puede chatear con el personal: ve los canales y chats de los que es miembro, y las reuniones que organiza o
         a las que lo invitan. Sin perm_create: al crear un canal o una reunión todavía no es miembro. Ausencias se
         bloquea en models/ir_rule.py (no es dependencia del cotizador). -->
    <record id="rule_externo_discuss_channel" model="ir.rule">
        <field name="name">Cotizador: un usuario externo ve solo sus canales y chats</field>
        <field name="model_id" ref="mail.model_discuss_channel"/>
        <field name="domain_force">[(1, '=', 1)] if not user.has_group('cotizador.group_usuario_externo') else [
            ('channel_member_ids.partner_id', '=', user.partner_id.id)]</field>
        <field name="perm_create" eval="False"/>
    </record>
    <record id="rule_externo_calendar_event" model="ir.rule">
        <field name="name">Cotizador: un usuario externo ve solo sus reuniones</field>
        <field name="model_id" ref="calendar.model_calendar_event"/>
        <field name="domain_force">[(1, '=', 1)] if not user.has_group('cotizador.group_usuario_externo') else [
            '|', ('user_id', '=', user.id), ('partner_ids', 'in', [user.partner_id.id])]</field>
        <field name="perm_create" eval="False"/>
    </record>

    <!-- La regla estándar de vendedor ("lo suyo o sin vendedor") le mostraría a cualquier concesionario las
         cotizaciones sin vendedor, como las que llegan de la tienda web. Para un externo: con vendedor, o de sus
         concesionarios. -->
    <record id="rule_externo_sale_order" model="ir.rule">
        <field name="name">Cotizador: un usuario externo no ve cotizaciones sin vendedor de otros equipos</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="domain_force">[(1, '=', 1)] if not user.has_group('cotizador.group_usuario_externo') else [
            '|', '|', ('user_id', '!=', False), ('team_id.user_id', '=', user.id), ('team_id.crm_team_member_ids.user_id', '=', user.id)]</field>
    </record>
    <record id="rule_externo_sale_order_line" model="ir.rule">
        <field name="name">Cotizador: un usuario externo no ve líneas de cotizaciones sin vendedor de otros equipos</field>
        <field name="model_id" ref="sale.model_sale_order_line"/>
        <field name="domain_force">[(1, '=', 1)] if not user.has_group('cotizador.group_usuario_externo') else [
            '|', '|', ('order_id.user_id', '!=', False), ('order_id.team_id.user_id', '=', user.id), ('order_id.team_id.crm_team_member_ids.user_id', '=', user.id)]</field>
    </record>
    <record id="rule_externo_sale_report" model="ir.rule">
        <field name="name">Cotizador: un usuario externo no ve en el análisis ventas sin vendedor de otros equipos</field>
        <field name="model_id" ref="sale.model_sale_report"/>
        <field name="domain_force">[(1, '=', 1)] if not user.has_group('cotizador.group_usuario_externo') else [
            '|', '|', ('user_id', '!=', False), ('team_id.user_id', '=', user.id), ('team_id.crm_team_member_ids.user_id', '=', user.id)]</field>
    </record>
    <record id="rule_externo_crm_lead" model="ir.rule">
        <field name="name">Cotizador: un usuario externo no ve oportunidades sin vendedor de otros equipos</field>
        <field name="model_id" ref="crm.model_crm_lead"/>
        <field name="domain_force">[(1, '=', 1)] if not user.has_group('cotizador.group_usuario_externo') else [
            '|', '|', ('user_id', '!=', False), ('team_id.user_id', '=', user.id), ('team_id.crm_team_member_ids.user_id', '=', user.id)]</field>
    </record>
    <record id="rule_externo_account_move" model="ir.rule">
        <field name="name">Cotizador: un usuario externo no ve facturas sin vendedor</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="domain_force">[(1, '=', 1)] if not user.has_group('cotizador.group_usuario_externo') else [('invoice_user_id', '!=', False)]</field>
    </record>
    <record id="rule_externo_account_move_line" model="ir.rule">
        <field name="name">Cotizador: un usuario externo no ve apuntes de facturas sin vendedor</field>
        <field name="model_id" ref="account.model_account_move_line"/>
        <field name="domain_force">[(1, '=', 1)] if not user.has_group('cotizador.group_usuario_externo') else [('move_id.invoice_user_id', '!=', False)]</field>
    </record>
</odoo>
