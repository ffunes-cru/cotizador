<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="cotizador.ConfiguradorStudioTemplate">
        <div class="o_cotizador_studio d-flex flex-column h-100 bg-body text-body" t-ref="root">
            
            <!-- HEADER SUPERIOR ESTILO CRUCIANELLI -->
            <div class="studio-header px-4 py-3 border-bottom d-flex align-items-center justify-content-between flex-wrap gap-3 bg-body-tertiary flex-shrink-0">
                <div class="d-flex align-items-center gap-3">
                    <div class="studio-brand-badge rounded-circle bg-danger text-white d-flex align-items-center justify-content-center fw-bold shadow-sm">
                        <i class="fa fa-sliders fa-lg"/>
                    </div>
                    <div>
                        <h4 class="mb-0 fw-bold text-danger text-uppercase letter-spacing-1">Configurador Studio</h4>
                        <span class="text-muted small">Panel de ingeniería y administración de máquinas configurables</span>
                    </div>
                </div>

                <!-- SELECTOR DE MODELO DE MÁQUINA -->
                <div class="d-flex align-items-center gap-2">
                    <span class="fw-bold small text-muted text-uppercase">Modelo:</span>
                    <select class="form-select form-select-sm fw-bold border-danger-subtle shadow-sm" style="min-width: 180px;"
                            t-att-value="state.selectedModelId"
                            t-on-change="onSelectModelChange">
                        <t t-foreach="state.models" t-as="m" t-key="m.id">
                            <option t-att-value="m.id" t-esc="m.name"/>
                        </t>
                    </select>
                </div>

                <!-- BOTÓN DESPLEGABLE DE KPIS / MÉTRICAS -->
                <button class="btn btn-sm d-inline-flex align-items-center gap-2 shadow-sm fw-semibold"
                        t-att-class="state.showKpis ? 'btn-danger' : 'btn-outline-secondary'"
                        t-on-click="toggleKpis"
                        title="Mostrar u ocultar panel de métricas para ganar espacio vertical">
                    <i class="fa" t-att-class="state.showKpis ? 'fa-chevron-up' : 'fa-chart-pie'"/>
                    <span>Métricas</span>
                    <span class="badge rounded-pill bg-body text-body border small" t-if="!state.showKpis">
                        <t t-esc="(state.modelData and state.modelData.configs and state.modelData.configs.length) || 0"/> configs
                    </span>
                </button>

                <!-- BOTONES DE ACCIONES CENTRALIZADAS -->
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <button class="btn btn-sm btn-success d-inline-flex align-items-center gap-1 shadow-sm fw-bold"
                            t-on-click="openNewConfigWizard"
                            title="Crear una nueva configuración para cotizar">
                        <i class="fa fa-plus-circle"/> Nueva Configuración
                    </button>
                    <button class="btn btn-sm btn-outline-danger d-inline-flex align-items-center gap-1 shadow-sm fw-semibold"
                            t-on-click="openEngineeringWizard"
                            title="Sincronizar códigos de referencia con Teamcenter">
                        <i class="fa fa-cogs"/> Códigos de Ingeniería
                    </button>
                    <button class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1 shadow-sm"
                            t-on-click="openImportWizard"
                            title="Importador masivo por CSV / Excel">
                        <i class="fa fa-upload"/> Importar CSV
                    </button>
                    <button class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1 shadow-sm"
                            t-on-click="openLegacyRawView"
                            title="Ver registros brutos en Odoo">
                        <i class="fa fa-database"/> Datos Raw
                    </button>
                </div>
            </div>

            <!-- SPINNER DE CARGA -->
            <t t-if="state.loading or state.loadingModel">
                <div class="flex-grow-1 d-flex flex-column align-items-center justify-content-center p-5 text-muted">
                    <i class="fa fa-circle-o-notch fa-spin fa-3x text-danger mb-3"/>
                    <span class="fs-5">Cargando matriz y configuraciones del modelo...</span>
                </div>
            </t>

            <!-- CONTENIDO PRINCIPAL: ÁRBOL DE COLUMNAS -->
            <t t-else="">
                <!-- TARJETAS DE KPIS SUPERIORES DESPLEGABLES -->
                <div t-if="state.showKpis" class="px-4 py-3 border-bottom bg-body flex-shrink-0">
                    <div class="row g-3">
                        <div class="col-6 col-md-3">
                            <div class="p-3 rounded-3 border bg-body-tertiary shadow-sm">
                                <div class="text-muted small fw-bold text-uppercase">Variantes Físicas / Teóricas</div>
                                <div class="fs-4 fw-bold text-body mt-1">
                                    <t t-esc="(state.modelData and state.modelData.total_variants) || 0"/>
                                </div>
                                <div class="small text-muted">Combinaciones de producto</div>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="p-3 rounded-3 border bg-body-tertiary shadow-sm">
                                <div class="text-muted small fw-bold text-uppercase">Códigos de Ingeniería</div>
                                <div class="fs-4 fw-bold text-success mt-1">
                                    <t t-esc="(state.modelData and state.modelData.coded_variants) || 0"/>
                                    <span class="fs-6 text-muted fw-normal ms-1" t-if="state.modelData and state.modelData.total_variants">
                                        (<t t-esc="codedPercentage"/>%)
                                    </span>
                                </div>
                                <div class="small text-muted">Variantes con código Teamcenter</div>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="p-3 rounded-3 border bg-body-tertiary shadow-sm">
                                <div class="text-muted small fw-bold text-uppercase">Configuraciones Permitidas</div>
                                <div class="fs-4 fw-bold text-primary mt-1">
                                    <t t-esc="(state.modelData and state.modelData.configs and state.modelData.configs.length) || 0"/>
                                </div>
                                <div class="small text-muted">Activas para cotizar en ventas</div>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="p-3 rounded-3 border bg-body-tertiary shadow-sm">
                                <div class="text-muted small fw-bold text-uppercase">Accesorios en Catálogo</div>
                                <div class="fs-4 fw-bold text-body mt-1">
                                    <t t-esc="(state.modelData and state.modelData.accessories_catalog and state.modelData.accessories_catalog.length) || 0"/>
                                </div>
                                <div class="small text-muted">Disponibles para vincular</div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ÁRBOL DE COLUMNAS (EXPLORADOR JERÁRQUICO CON ESPACIO COMPLETO) -->
                <div class="flex-grow-1 d-flex flex-column overflow-hidden bg-body" style="min-height: 0; height: 100%;">
                    
                    <!-- BARRA SUPERIOR DE RUTA ACTIVA (BREADCRUMBS) -->
                    <div class="studio-tree-breadcrumbs px-4 py-2 border-bottom d-flex align-items-center justify-content-between flex-wrap gap-2 bg-body-tertiary flex-shrink-0">
                        <div class="d-flex align-items-center gap-2 flex-wrap">
                            <span class="text-muted small fw-bold text-uppercase me-1">
                                <i class="fa fa-compass me-1 text-danger"/>Ruta:
                            </span>
                            <button class="btn btn-xs rounded-pill shadow-sm"
                                    t-att-class="state.treePath.length === 0 ? 'btn-danger' : 'btn-outline-secondary'"
                                    t-on-click="resetTreePath">
                                <i class="fa fa-cube me-1"/><t t-esc="(state.modelData and state.modelData.modelo and state.modelData.modelo.name) || 'Modelo'"/>
                            </button>
                            <t t-foreach="treeBreadcrumbs" t-as="crumb" t-key="crumb.level">
                                <i class="fa fa-angle-right text-muted small"/>
                                <button class="btn btn-xs rounded-pill shadow-sm"
                                        t-att-class="crumb.level === state.treePath.length - 1 ? 'btn-danger' : 'btn-outline-secondary'"
                                        t-on-click="() => this.jumpToTreeLevel(crumb.level + 1)">
                                    <span class="fw-normal text-muted me-1"><t t-esc="crumb.attrName"/>:</span>
                                    <strong><t t-esc="crumb.valName"/></strong>
                                </button>
                            </t>
                        </div>

                        <div class="d-flex align-items-center gap-2">
                            <button class="btn btn-xs rounded-pill shadow-sm d-inline-flex align-items-center gap-1"
                                    t-att-class="state.hideZeroPercent ? 'btn-outline-danger' : 'btn-outline-secondary'"
                                    t-on-click="toggleHideZeroPercent"
                                    title="Alternar visibilidad de opciones sin combinaciones activas (0%)">
                                <i class="fa" t-att-class="state.hideZeroPercent ? 'fa-eye-slash' : 'fa-eye'"/>
                                <t t-if="state.hideZeroPercent">Ocultando 0%</t>
                                <t t-else="">Mostrando 0%</t>
                            </button>
                            <button t-if="state.treePath.length &gt; 0"
                                    class="btn btn-xs btn-outline-secondary shadow-sm"
                                    t-on-click="resetTreePath"
                                    title="Volver a la raíz del árbol">
                                <i class="fa fa-undo me-1"/> Reiniciar Rama
                            </button>
                        </div>
                    </div>

                    <!-- LIENZO DE COLUMNAS DE NODOS DEL ÁRBOL -->
                    <div class="studio-tree-canvas flex-grow-1 d-flex p-4 gap-4 bg-body-secondary-subtle" t-ref="treeCanvas">
                        
                        <t t-if="!state.modelData or !state.modelData.attributes or state.modelData.attributes.length === 0">
                            <div class="m-auto text-center text-muted p-5 bg-body rounded-4 border shadow-sm">
                                <i class="fa fa-sitemap fa-3x text-secondary mb-3"/>
                                <h5>No hay líneas de atributos configuradas</h5>
                                <p class="small text-muted mb-0">Este modelo no posee atributos configurados en su plantilla de Odoo.</p>
                            </div>
                        </t>

                        <t t-else="">
                            <t t-foreach="treeColumns" t-as="col" t-key="col.level">
                                <div class="studio-tree-column d-flex flex-column rounded-3 border bg-body shadow-sm"
                                     t-att-class="col.isLeafLevel ? 'leaf-column' : ''">
                                    
                                    <!-- ============================================== -->
                                    <!-- CASO A: COLUMNA DE ATRIBUTO INTERMEDIO        -->
                                    <!-- ============================================== -->
                                    <t t-if="!col.isLeafLevel">
                                        <!-- Cabecera de Columna -->
                                        <div class="column-header px-3 py-2 border-bottom d-flex align-items-center justify-content-between bg-body-tertiary">
                                            <div class="d-flex align-items-center gap-2 text-truncate me-1">
                                                <span class="badge rounded-pill bg-danger-subtle text-danger fw-bold font-monospace">
                                                    <t t-esc="col.level + 1"/>
                                                </span>
                                                <span class="fw-bold small text-uppercase letter-spacing-1 text-truncate" style="max-width: 170px;" t-att-title="col.attribute.name">
                                                    <t t-esc="col.attribute.name"/>
                                                </span>
                                            </div>
                                            <span class="badge bg-secondary-subtle text-muted small">
                                                <t t-esc="col.nodes.length"/> opciones
                                            </span>
                                        </div>

                                        <!-- Lista de Nodos con Scroll Vertical Fluido -->
                                        <div class="column-body">
                                            <t t-foreach="col.nodes" t-as="node" t-key="node.id">
                                                <div class="studio-tree-node rounded-3 p-3 border transition-all cursor-pointer shadow-sm position-relative"
                                                     t-att-class="node.isSelected ? 'node-selected border-danger shadow' : 'border-light-subtle bg-body'"
                                                     t-on-click="() => this.selectTreeNode(col.level, node.id)">
                                                    
                                                    <div class="d-flex align-items-center justify-content-between gap-2 mb-2">
                                                        <div class="fw-bold text-body fs-6 text-truncate" t-att-title="node.name">
                                                            <t t-esc="node.name"/>
                                                        </div>
                                                        <i class="fa fa-chevron-right text-muted small transition-transform"
                                                           t-att-class="node.isSelected ? 'text-danger' : 'opacity-50'"/>
                                                    </div>

                                                    <div class="d-flex align-items-center justify-content-between small text-muted mb-1">
                                                        <span class="font-monospace">
                                                            <strong class="text-body"><t t-esc="node.stats.active"/></strong> / <t t-esc="node.stats.total"/> activas
                                                        </span>
                                                        <span class="badge"
                                                              t-att-class="node.stats.percent === 100 ? 'bg-success-subtle text-success' : (node.stats.active &gt; 0 ? 'bg-warning-subtle text-warning-emphasis' : 'bg-secondary-subtle text-muted')">
                                                            <t t-esc="node.stats.percent"/>%
                                                        </span>
                                                    </div>
                                                    <div class="progress" style="height: 4px;">
                                                        <div class="progress-bar"
                                                             t-att-class="node.stats.percent === 100 ? 'bg-success' : 'bg-danger'"
                                                             t-att-style="'width: ' + node.stats.percent + '%'"/>
                                                    </div>

                                                    <div t-if="node.stats.missing &gt; 0" class="mt-2 pt-2 border-top d-flex justify-content-end">
                                                        <button class="btn btn-xs btn-outline-danger d-inline-flex align-items-center gap-1 shadow-sm"
                                                                t-on-click.stop="() => this.openBranchCreateModal(node.combo, node.name, node.stats.missing)"
                                                                title="Crear todas las configuraciones faltantes en esta rama">
                                                            <i class="fa fa-bolt"/> Habilitar <t t-esc="node.stats.missing"/> faltantes
                                                        </button>
                                                    </div>
                                                </div>
                                            </t>
                                        </div>
                                    </t>

                                    <!-- ============================================== -->
                                    <!-- CASO B: COLUMNA FINAL DE CONFIGURACIÓN (HOJA)  -->
                                    <!-- ============================================== -->
                                    <t t-else="">
                                        <div class="column-header px-3 py-2 border-bottom d-flex align-items-center justify-content-between bg-body-tertiary">
                                            <div class="d-flex align-items-center gap-2">
                                                <span class="badge rounded-pill bg-success-subtle text-success fw-bold font-monospace">
                                                    <i class="fa fa-flag-checkered"/>
                                                </span>
                                                <span class="fw-bold small text-uppercase letter-spacing-1">
                                                    Configuración Final
                                                </span>
                                            </div>
                                            <span class="badge" t-att-class="col.leafData.exists ? 'bg-success' : 'bg-warning text-dark'">
                                                <t t-if="col.leafData.exists">Habilitada</t>
                                                <t t-else="">Sin Habilitar</t>
                                            </span>
                                        </div>

                                        <div class="column-body">
                                            <!-- Tarjeta de Resumen de Combinación -->
                                            <div class="p-3 rounded-3 border bg-body-tertiary shadow-sm mb-3">
                                                <div class="text-muted small fw-bold text-uppercase mb-1">
                                                    <i class="fa fa-cubes me-1 text-danger"/>Variante Seleccionada:
                                                </div>
                                                <div class="fw-bold text-body fs-6 mb-2">
                                                    <t t-esc="col.leafData.label"/>
                                                </div>
                                                <div class="d-flex flex-wrap gap-1">
                                                    <t t-foreach="treeBreadcrumbs" t-as="crumb" t-key="crumb.level">
                                                        <span class="badge bg-body border text-body small">
                                                            <span class="text-muted fw-normal"><t t-esc="crumb.attrName"/>:</span>
                                                            <strong><t t-esc="crumb.valName"/></strong>
                                                        </span>
                                                    </t>
                                                </div>
                                            </div>

                                            <!-- SUB-CASO 1: YA EXISTE EN ODOO -->
                                            <t t-if="col.leafData.exists">
                                                <div class="p-3 rounded-3 border border-success-subtle bg-success-subtle bg-opacity-10 shadow-sm d-flex flex-column gap-3">
                                                    <div class="d-flex align-items-center justify-content-between">
                                                        <span class="badge bg-success d-inline-flex align-items-center gap-1 fs-6 px-3 py-1">
                                                            <i class="fa fa-check-circle"/> Habilitada #<t t-esc="col.leafData.config.id"/>
                                                        </span>
                                                        <button class="btn btn-xs btn-outline-danger shadow-sm d-inline-flex align-items-center gap-1"
                                                                t-on-click="() => this.deleteSingleConfig(col.leafData.config.id)"
                                                                title="Eliminar esta configuración de la matriz comercial">
                                                            <i class="fa fa-trash"/> Eliminar
                                                        </button>
                                                    </div>

                                                    <!-- Editor de Código de Ingeniería (Teamcenter) -->
                                                    <div class="p-3 rounded-2 bg-body border shadow-sm">
                                                        <span class="text-muted small fw-bold text-uppercase d-block mb-1">
                                                            <i class="fa fa-cogs me-1 text-danger"/>Código de Ingeniería (Teamcenter):
                                                        </span>
                                                        <t t-if="state.isEditingLeafExtId">
                                                            <div class="input-group input-group-sm mt-1">
                                                                <input type="text" class="form-control font-monospace fw-bold"
                                                                       placeholder="Ej: GRINGA-16-525"
                                                                       t-att-value="state.leafEditingExtId"
                                                                       t-on-input="onLeafEditingExtIdInput"/>
                                                                <button class="btn btn-success btn-sm"
                                                                        t-on-click="() => this.saveLeafExtId(col.leafData.config.id)"
                                                                        title="Guardar código de ingeniería">
                                                                    <i class="fa fa-check"/>
                                                                </button>
                                                                <button class="btn btn-secondary btn-sm"
                                                                        t-on-click="cancelLeafExtId"
                                                                        title="Cancelar">
                                                                    <i class="fa fa-times"/>
                                                                </button>
                                                            </div>
                                                        </t>
                                                        <t t-else="">
                                                            <div class="d-flex align-items-center justify-content-between mt-1">
                                                                <span class="font-monospace fw-bold fs-6 text-truncate me-2"
                                                                      t-att-class="col.leafData.config.ext_id ? 'text-body' : 'text-muted fst-italic'">
                                                                    <t t-esc="col.leafData.config.ext_id || 'Sin código asignado'"/>
                                                                </span>
                                                                <button class="btn btn-xs btn-outline-secondary"
                                                                        t-on-click="() => this.startEditLeafExtId(col.leafData.config.ext_id)"
                                                                        title="Cargar / Modificar código de ingeniería">
                                                                    <i class="fa fa-pencil me-1"/> Editar
                                                                </button>
                                                            </div>
                                                        </t>
                                                    </div>

                                                    <!-- Editor de Precio Base de Lista -->
                                                    <div class="p-3 rounded-2 bg-body border shadow-sm">
                                                        <span class="text-muted small fw-bold text-uppercase d-block mb-1">
                                                            <i class="fa fa-dollar me-1 text-success"/>Precio Base de Lista:
                                                        </span>
                                                        <t t-if="state.isEditingLeafPrice">
                                                            <div class="input-group input-group-sm mt-1">
                                                                <span class="input-group-text">$</span>
                                                                <input type="number" class="form-control fw-bold"
                                                                       t-att-value="state.leafEditingPrice"
                                                                       t-on-input="onLeafEditingPriceInput"/>
                                                                <button class="btn btn-success btn-sm"
                                                                        t-on-click="() => this.saveLeafPrice(col.leafData.config.id)"
                                                                        title="Guardar nuevo precio">
                                                                    <i class="fa fa-check"/>
                                                                </button>
                                                                <button class="btn btn-secondary btn-sm"
                                                                        t-on-click="cancelLeafPrice"
                                                                        title="Cancelar">
                                                                    <i class="fa fa-times"/>
                                                                </button>
                                                            </div>
                                                        </t>
                                                        <t t-else="">
                                                            <div class="d-flex align-items-center justify-content-between mt-1">
                                                                <span class="fs-4 fw-bold text-dark">
                                                                    <t t-esc="formatCurrency(col.leafData.config.price)"/>
                                                                </span>
                                                                <button class="btn btn-xs btn-outline-secondary"
                                                                        t-on-click="() => this.startEditLeafPrice(col.leafData.config.price)"
                                                                        title="Editar precio base">
                                                                    <i class="fa fa-pencil me-1"/> Editar
                                                                </button>
                                                            </div>
                                                        </t>
                                                    </div>

                                                    <!-- Accesorios Vinculados -->
                                                    <div class="d-flex align-items-center justify-content-between text-muted small p-2 rounded-2 bg-body border">
                                                        <span>Accesorios Vinculados:</span>
                                                        <span class="badge rounded-pill bg-light text-dark border px-2 py-1">
                                                            <i class="fa fa-puzzle-piece text-muted me-1"/>
                                                            <t t-esc="col.leafData.config.accessory_count"/> accesorios
                                                        </span>
                                                    </div>
                                                </div>
                                            </t>

                                            <!-- SUB-CASO 2: NO EXISTE EN ODOO (SIN HABILITAR) -->
                                            <t t-else="">
                                                <div class="p-3 rounded-3 border border-warning-subtle bg-warning-subtle bg-opacity-10 shadow-sm d-flex flex-column gap-3">
                                                    <div class="d-flex align-items-center gap-2">
                                                        <span class="badge bg-warning text-dark fw-bold fs-6 px-3 py-1">
                                                            <i class="fa fa-bolt me-1"/>Sin Habilitar
                                                        </span>
                                                        <span class="text-muted small">No cotizable en ventas</span>
                                                    </div>
                                                    <p class="small text-muted mb-0">
                                                        Esta combinación es viable físicamente pero aún no está habilitada comercialmente en el cotizador.
                                                    </p>

                                                    <div>
                                                        <label class="form-label fw-bold small text-uppercase">Precio Base Inicial ($):</label>
                                                        <div class="input-group">
                                                            <span class="input-group-text">$</span>
                                                            <input type="number" class="form-control fw-bold"
                                                                   placeholder="0.00"
                                                                   t-att-value="state.leafNewPrice || col.leafData.defaultPrice"
                                                                   t-on-input="onLeafNewPriceInput"/>
                                                        </div>
                                                    </div>

                                                    <div>
                                                        <label class="form-label fw-bold small text-uppercase">Código de Ingeniería / Teamcenter (opcional):</label>
                                                        <input type="text" class="form-control font-monospace"
                                                               placeholder="Ej: GRINGA-16-525"
                                                               t-att-value="state.leafNewExtId"
                                                               t-on-input="onLeafNewExtIdInput"/>
                                                    </div>

                                                    <button class="btn btn-danger w-100 fw-bold shadow-sm d-inline-flex align-items-center justify-content-center gap-2 py-2 mt-1"
                                                            t-on-click="() => this.submitQuickCreateLeaf(col.leafData.combo)">
                                                        <i class="fa fa-plus-circle fa-lg"/> Crear y Habilitar en Odoo
                                                    </button>
                                                </div>
                                            </t>
                                        </div>
                                    </t>

                                </div>
                            </t>
                        </t>

                    </div>
                </div>
            </t>

            <!-- ============================================================= -->
            <!-- MODAL: HABILITAR TODAS LAS VARIANTES DE UNA RAMA              -->
            <!-- ============================================================= -->
            <div t-if="state.showBranchModal" class="modal fade show d-block" style="background: rgba(0,0,0,0.5); z-index: 1050;">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content shadow-lg border-0">
                        <div class="modal-header bg-danger text-white">
                            <h5 class="modal-title fw-bold">
                                <i class="fa fa-bolt me-2"/>Habilitar Rama Completa
                            </h5>
                            <button type="button" class="btn-close btn-close-white" t-on-click="closeBranchCreateModal"/>
                        </div>
                        <div class="modal-body p-4">
                            <p class="text-muted">
                                Se crearán <strong><t t-esc="state.branchMissingCount"/></strong> combinaciones faltantes bajo la rama:
                            </p>
                            <div class="p-3 rounded-3 bg-danger-subtle border border-danger-subtle mb-3">
                                <div class="fw-bold text-danger"><t t-esc="state.branchLabel"/></div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-bold">Precio Base para estas <t t-esc="state.branchMissingCount"/> configuraciones ($):</label>
                                <div class="input-group input-group-lg">
                                    <span class="input-group-text">$</span>
                                    <input type="number" class="form-control fw-bold"
                                           placeholder="0.00"
                                           t-att-value="state.branchBasePrice"
                                           t-on-input="onBranchBasePriceInput"/>
                                </div>
                                <div class="form-text">Podrá modificar el precio de cada una de forma individual posteriormente.</div>
                            </div>
                        </div>
                        <div class="modal-footer bg-light">
                            <button type="button" class="btn btn-secondary" t-on-click="closeBranchCreateModal">Cancelar</button>
                            <button type="button" class="btn btn-danger fw-bold" t-on-click="submitBranchCreate">
                                <i class="fa fa-magic me-1"/> Crear <t t-esc="state.branchMissingCount"/> Configuraciones
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ============================================================= -->
            <!-- MODAL: ASISTENTE "+ NUEVA CONFIGURACIÓN"                      -->
            <!-- ============================================================= -->
            <div t-if="state.showNewConfigWizardModal" class="modal fade show d-block" style="background: rgba(0,0,0,0.5); z-index: 1050;">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content shadow-lg border-0">
                        <div class="modal-header bg-danger text-white">
                            <h5 class="modal-title fw-bold">
                                <i class="fa fa-plus-circle me-2"/>Nueva Configuración de Sembradora
                            </h5>
                            <button type="button" class="btn-close btn-close-white" t-on-click="closeNewConfigWizard"/>
                        </div>
                        <div class="modal-body p-4">
                            <p class="text-muted small mb-3">
                                Seleccione un valor para cada atributo del modelo <strong><t t-esc="(state.modelData and state.modelData.modelo and state.modelData.modelo.name) || ''"/></strong>:
                            </p>

                            <t t-if="state.modelData and state.modelData.attributes">
                                <t t-foreach="state.modelData.attributes" t-as="attr" t-key="attr.id">
                                    <div class="mb-3">
                                        <label class="form-label fw-bold small text-uppercase"><t t-esc="attr.name"/>:</label>
                                        <select class="form-select"
                                                t-on-change="(ev) => this.onWizardValueChange(attr.id, ev)">
                                            <option value="">-- Seleccione <t t-esc="attr.name"/> --</option>
                                            <t t-foreach="attr.values" t-as="val" t-key="val.id">
                                                <option t-att-value="val.id" t-esc="val.name"/>
                                            </t>
                                        </select>
                                    </div>
                                </t>
                            </t>

                            <div class="mb-3">
                                <label class="form-label fw-bold">Precio Base de Lista ($):</label>
                                <div class="input-group">
                                    <span class="input-group-text">$</span>
                                    <input type="number" class="form-control fw-bold"
                                           placeholder="0.00"
                                           t-att-value="state.wizardPrice"
                                           t-on-input="onWizardPriceInput"/>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-bold">Código de Ingeniería / Teamcenter (Opcional):</label>
                                <input type="text" class="form-control font-monospace"
                                       placeholder="Ej: GRINGA-16-525"
                                       t-att-value="state.wizardExtId"
                                       t-on-input="onWizardExtIdInput"/>
                            </div>
                        </div>
                        <div class="modal-footer bg-light">
                            <button type="button" class="btn btn-secondary" t-on-click="closeNewConfigWizard">Cancelar</button>
                            <button type="button" class="btn btn-danger fw-bold" t-on-click="submitNewConfigWizard">
                                <i class="fa fa-check me-1"/> Crear Configuración
                            </button>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </t>

</templates>
