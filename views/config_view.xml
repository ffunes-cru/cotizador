<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_sembradora_config_rel_form" model="ir.ui.view">
        <field name="name">sembradora.config.rel.form</field>
        <field name="model">sembradora.config.rel</field>
        <field name="arch" type="xml">
            <form string="Configuración de Máquina">
                <sheet>
                    <group>
                        <field name="modelo_id"/>
                        <field name="value_ids" widget="many2many_tags"/>
                        <field name="price"/>
                    </group>
                    <group string="Descripción de la Configuración">
                        <field name="description" nolabel="1" colspan="2"/>
                    </group>
                    <separator string="Accesorios Compatibles con Precio"/>
                    <field name="accessory_line_ids" nolabel="1">
                        <list editable="bottom">
                            <field name="product_id"/>
                            <field name="rule_ids" widget="many2many_tags" string="Reglas"/>
                            <field name="is_trigger" string="Trigger" optional="show"/>
                            <field name="price"/>
                            <field name="quantity" optional="hide"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_sembradora_config_rel_list" model="ir.ui.view">
        <field name="name">sembradora.config.rel.list</field>
        <field name="model">sembradora.config.rel</field>
        <field name="arch" type="xml">
            <list>
                <field name="modelo_id"/>
                <field name="value_ids" widget="many2many_tags"/>
                <field name="price"/>
            </list>
        </field>
    </record>

    <record id="action_sembradora_config_rel" model="ir.actions.act_window">
        <field name="name">Matriz de Configuración</field>
        <field name="res_model">sembradora.config.rel</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_sembradora_config_root"
              name="Configurador Sembradoras"
              parent="sale.menu_sale_config"
              sequence="100"/>

    <menuitem id="menu_sembradora_config_matriz"
              name="Matriz de Configuración"
              parent="menu_sembradora_config_root"
              sequence="10"
              action="action_sembradora_config_rel"/>

    <!-- Vista lista para importar accesorios por configuración -->
    <record id="view_sembradora_config_acc_line_list" model="ir.ui.view">
        <field name="name">sembradora.config.accessory.line.list</field>
        <field name="model">sembradora.config.accessory.line</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="ext_id" optional="hide"/>
                <field name="config_id"/>
                <field name="product_id"/>
                <field name="rule_ids" widget="many2many_tags" string="Reglas"/>
                <field name="is_trigger" string="Trigger" optional="show"/>
                <field name="price"/>
                <field name="quantity" optional="hide"/>
                <field name="exclusion_group" optional="hide" string="Grupo (legacy)"/>
            </list>
        </field>
    </record>

    <record id="action_sembradora_config_acc_line" model="ir.actions.act_window">
        <field name="name">Accesorios por Configuración</field>
        <field name="res_model">sembradora.config.accessory.line</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem id="menu_sembradora_config_acc_line"
              name="Accesorios por Configuración"
              parent="menu_sembradora_config_root"
              sequence="20"
              action="action_sembradora_config_acc_line"/>
</odoo>
