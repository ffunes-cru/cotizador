<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_sembradora_config_rel_list" model="ir.ui.view">
        <field name="name">sembradora.config.rel.list</field>
        <field name="model">sembradora.config.rel</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="modelo_id"/>
                <field name="value_ids" widget="many2many_tags"/>
                <field name="accesories_id" widget="many2many_tags"/>
                <field name="price"/>
            </list>
        </field>
    </record>

    <record id="action_sembradora_config_rel" model="ir.actions.act_window">
        <field name="name">Matriz de Configuración</field>
        <field name="res_model">sembradora.config.rel</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_sembradora_config_root"
              name="Configurador Sembradoras"
              parent="sale.menu_sale_config"
              sequence="100"
              action="action_sembradora_config_rel"/>
</odoo>
