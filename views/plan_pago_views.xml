<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- ============================================= -->
    <!-- WIZARD: Cargar Planes de Pago en Cotización   -->
    <!-- ============================================= -->
    <record id="view_plan_pago_wizard_form" model="ir.ui.view">
        <field name="name">cotizador.plan.pago.wizard.form</field>
        <field name="model">cotizador.plan.pago.wizard</field>
        <field name="arch" type="xml">
            <form string="Seleccionar Plan de Pago">
                <sheet>
                    <field name="sale_order_id" invisible="1"/>
                    <separator string="Opciones de Planes de Pago Disponibles"/>
                    <p class="text-muted mb-3">
                        Seleccione el plan de pago deseado haciendo clic en el botón <strong>Elegir Plan</strong> de la fila correspondiente. 
                        Solo se puede asociar un único plan de pago por cotización.
                    </p>
                    <field name="wizard_line_ids" nolabel="1">
                        <!-- Odoo permite agrupar por tipo nativamente para un look espectacular -->
                        <list create="0" edit="0" delete="0" expand="1">
                            <field name="tipo" string="Tipo de Plan"/>
                            <field name="name" string="Detalle de la Opción"/>
                            <field name="descuento" string="Descuento / Recargo (%)" decoration-bf="1"/>
                            <field name="total_simulado" string="Total Simulado" decoration-bf="1" widget="monetary"/>
                            <button name="action_select_line" 
                                    string="Elegir Plan" 
                                    type="object" 
                                    class="btn-primary btn-sm"
                                    icon="fa-check"/>
                        </list>
                    </field>
                </sheet>
                <!-- 
                <footer>
                    <button name="action_eliminar_plan" string="Limpiar Plan Seleccionado" type="object" class="btn-danger" icon="fa-trash"/>
                    <button string="Cerrar" class="btn-secondary" special="cancel"/>
                </footer>
                -->
            </form>
        </field>
    </record>

    <!-- ============================================= -->
    <!-- CONFIG: Plantillas de Planes de Pago          -->
    <!-- ============================================= -->
    <record id="view_plan_pago_template_form" model="ir.ui.view">
        <field name="name">cotizador.plan.pago.template.form</field>
        <field name="model">cotizador.plan.pago.template</field>
        <field name="arch" type="xml">
            <form string="Plantilla de Plan de Pago">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="tipo"/>
                        <field name="active"/>
                    </group>
                    <separator string="Opciones del Plan"/>
                    <field name="line_ids" nolabel="1">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <!-- Canje Cereal (Solo visible si el tipo de plantilla es canje_cereal) -->
                            <field name="opcion" 
                                   column_invisible="parent.tipo != 'canje_cereal'" 
                                   required="parent.tipo == 'canje_cereal'"/>
                            <field name="entrega_canje" 
                                   column_invisible="parent.tipo != 'canje_cereal'"/>
                            <field name="condicion" 
                                   column_invisible="parent.tipo != 'canje_cereal'"/>
                            <!-- Cheques (Solo visible si el tipo de plantilla es cheques) -->
                            <field name="plan_cheques" 
                                   column_invisible="parent.tipo != 'cheques'"
                                   required="parent.tipo == 'cheques'"/>
                            <field name="promedio_dias" 
                                   column_invisible="parent.tipo != 'cheques'"/>
                            <field name="cheques_desc" 
                                   column_invisible="parent.tipo != 'cheques'"/>
                            <!-- Documentos (Solo visible si el tipo de plantilla es documentos) -->
                            <field name="plan_documentos" 
                                   column_invisible="parent.tipo != 'documentos'"
                                   required="parent.tipo == 'documentos'"/>
                            <field name="entrega_pct" 
                                   column_invisible="parent.tipo != 'documentos'"/>
                            <field name="saldo" 
                                   column_invisible="parent.tipo != 'documentos'"/>
                            <!-- Crédito Bancario (Solo visible si el tipo de plantilla es credito_bancario) -->
                            <field name="banco_linea" 
                                   column_invisible="parent.tipo != 'credito_bancario'"
                                   required="parent.tipo == 'credito_bancario'"/>
                            <field name="plazo_tasa" 
                                   column_invisible="parent.tipo != 'credito_bancario'"/>
                            <field name="financiacion" 
                                   column_invisible="parent.tipo != 'credito_bancario'"/>
                            <!-- Común a todos -->
                            <field name="descuento"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_plan_pago_template_list" model="ir.ui.view">
        <field name="name">cotizador.plan.pago.template.list</field>
        <field name="model">cotizador.plan.pago.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="tipo"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="action_plan_pago_template" model="ir.actions.act_window">
        <field name="name">Plantillas de Planes de Pago</field>
        <field name="res_model">cotizador.plan.pago.template</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_plan_pago_template"
              name="Plantillas Planes de Pago"
              parent="menu_sembradora_config_root"
              sequence="30"
              action="action_plan_pago_template"/>

