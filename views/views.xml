<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_sembradora_config_wizard_form" model="ir.ui.view">
        <field name="name">sembradora.config.wizard.form</field>
        <field name="model">sembradora.config.wizard</field>
        <field name="arch" type="xml">
            <form string="Configurar Equipo">
                <sheet>
                    <group>
                        <field name="modelo_id" options="{'no_create': True}"/>
                        <field name="sale_order_id" invisible="1"/>
                    </group>
                    <separator string="Seleccione la configuración"/>
                    <field name="line_ids" nolabel="1">
                        <list editable="bottom" create="0" delete="1">
                            <field name="attribute_id" readonly="1" force_save="1"
                                invisible="is_hidden"/>
                            <field name="value_id" 
                                domain="[('id', 'in', value_domain_ids)]" 
                                options="{'no_create': True, 'no_open': True}"
                                readonly="is_single_option"
                                invisible="is_hidden"
                                force_save="1"/>
                            <field name="value_domain_ids" column_invisible="1"/>
                            <field name="is_single_option" column_invisible="1"/>
                            <field name="show_in_description" column_invisible="1"/>
                            <field name="is_hidden" column_invisible="1"/>
                        </list>
                    </field>

                    <field name="config_finalizada" invisible="1"/>

                    <group string="Paso Final: Accesorios Compatibles" 
                        invisible="not config_finalizada">

                        <group>
                            <field name="config_base_price" readonly="1"/>
                        </group>
                        
                        <field name="accessory_selection_ids" nolabel="1">
                            <list editable="bottom" create="0" delete="0">
                                <field name="selected" readonly="is_locked"/>
                                <field name="product_id" readonly="1"/>
                                <field name="quantity" readonly="1" force_save="1"/>
                                <field name="price_unit" readonly="1" force_save="1"/>
                                <field name="price" readonly="1" string="Subtotal" force_save="1"/>
                                <field name="is_locked" column_invisible="1"/>
                                <field name="is_inclusion_locked" column_invisible="1"/>
                                <field name="config_acc_line_id" column_invisible="1"/>
                            </list>
                        </field>

                        <group>
                            <field name="accessories_total" readonly="1"/>
                            <field name="total_price" readonly="1" class="fw-bold"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_confirm_config" string="Añadir a la Cotización" type="object" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_open_sembradora_wizard" model="ir.actions.act_window">
        <field name="name">Configurar Equipo</field>
        <field name="res_model">sembradora.config.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field> <field name="context">{'default_sale_order_id': active_id}</field>
    </record>

    <!-- Herencia de la vista de sale.order -->
    <record id="view_order_form_inherit_cotizador" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.cotizador</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- Redirigir el botón estándar de impresión de la cabecera a print_quotation -->
            <xpath expr="//header//button[@name='sale.action_report_saleorder']" position="attributes">
                <attribute name="name">print_quotation</attribute>
                <attribute name="type">object</attribute>
            </xpath>

            <!-- Botón Configurar en button_box -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_config_wizard" 
                        type="object" 
                        class="oe_stat_button" 
                        icon="fa-sliders"
                        invisible="state not in ('draft', 'sent')">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Configurar</span>
                    </div>
                </button>
                <button name="action_open_plan_pago_wizard" 
                        type="object" 
                        class="oe_stat_button" 
                        icon="fa-money"
                        invisible="state not in ('draft', 'sent')">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Planes de Pago</span>
                    </div>
                </button>
                <button name="action_ver_bcra_wizard" 
                        type="object" 
                        class="oe_stat_button" 
                        icon="fa-university"
                        invisible="not partner_id">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Situación BCRA</span>
                    </div>
                </button>
            </xpath>

            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="equipo_cotizado_id" options="{'no_create': True}"/>
                <field name="user_id" widget="many2one_avatar_user" string="Concesionario"/>
            </xpath>

            <!-- Ocultar columna estándar de porcentaje de descuento en líneas para evitar conflictos con los descuentos en cascada -->
            <xpath expr="//field[@name='order_line']//list//field[@name='discount']" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>

            <!-- Ocultar botón nativo de Descuento flotante debajo de las líneas para unificar en 'Añadir Descuento' -->
            <xpath expr="//div[@name='so_button_below_order_lines']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- Interceptar "Add a product" en order_line para mostrar Configurar Equipo, Añadir Equipo Usado y Añadir Descuento (Desktop) -->
            <xpath expr="//field[@name='order_line']//list//control" position="replace">
                <control>
                    <button name="action_open_config_wizard" 
                            type="object"
                            string="Configurar Equipo"
                            class="px-4 btn-link"
                            context="{'default_sale_order_id': parent.id, 'order_id': parent.id}"/>
                    <button name="action_open_equipo_usado_wizard" 
                            type="object"
                            string="Añadir Equipo Usado"
                            class="px-4 btn-link"
                            context="{'default_sale_order_id': parent.id, 'order_id': parent.id}"/>
                    <button name="action_open_descuento_wizard" 
                            type="object"
                            string="Añadir Descuento"
                            class="px-4 btn-link"
                            context="{'default_sale_order_id': parent.id, 'order_id': parent.id}"/>
                </control>
            </xpath>

            <!-- Interceptar controles de order_line en vista Kanban (Mobile) -->
            <xpath expr="//field[@name='order_line']//kanban//control" position="replace">
                <control>
                    <button name="action_open_config_wizard" 
                            type="object" 
                            string="Configurar Equipo" 
                            class="btn-primary" 
                            context="{'default_sale_order_id': parent.id, 'order_id': parent.id}"/>
                    <button name="action_open_equipo_usado_wizard" 
                            type="object" 
                            string="Añadir Equipo Usado" 
                            class="btn-secondary" 
                            context="{'default_sale_order_id': parent.id, 'order_id': parent.id}"/>
                    <button name="action_open_descuento_wizard" 
                            type="object" 
                            string="Añadir Descuento" 
                            class="btn-secondary" 
                            context="{'default_sale_order_id': parent.id, 'order_id': parent.id}"/>
                </control>
            </xpath>

            <!-- Pestaña Condiciones Generales y Planes de Pago -->
            <xpath expr="//notebook" position="inside">
                <page string="Condiciones y Planes de Pago" name="cotizador_terminos_planes">
                    <group>
                        <group string="Planes de Pago a Imprimir">
                            <p class="text-muted">
                                Seleccione qué planes de pago específicos se incluirán en la hoja de planes de pago de esta cotización. Si deja el campo vacío, se imprimirán todos los del catálogo.
                            </p>
                            <field name="plan_pago_line_ids" widget="many2many_tags" options="{'no_create': True}" nolabel="1"/>
                        </group>
                        <group string="Condiciones Generales Constantes">
                            <p class="text-muted">
                                Texto constante que se imprime automáticamente en el pie de página de la cotización.
                            </p>
                            <field name="condiciones_generales" nolabel="1" widget="text" class="w-100"/>
                        </group>
                    </group>
                </page>
            </xpath>

            <!-- Reemplazo del Bloque de Totales para mostrar Cascada Financiera (Imagen 1) -->
            <xpath expr="//group[@name='sale_total']" position="replace">
                <group class="oe_subtotal_footer oe_right" colspan="2" name="sale_total">
                    <field name="amount_subtotal_productos" widget="monetary" string="SUB TOTAL" options="{'currency_field': 'currency_id'}"/>
                    <field name="amount_iva_productos" widget="monetary" string="IVA" options="{'currency_field': 'currency_id'}"/>
                    <field name="amount_total_base" widget="monetary" string="TOTAL" class="fw-bold" options="{'currency_field': 'currency_id'}"/>
                    <field name="amount_descuentos" widget="monetary" string="Descuentos" class="text-danger fw-semibold" options="{'currency_field': 'currency_id'}" invisible="amount_descuentos == 0"/>
                    <field name="amount_total_con_descuentos" widget="monetary" string="TOTAL CON DESCUENTOS" class="fw-bold" options="{'currency_field': 'currency_id'}" invisible="amount_descuentos == 0"/>
                    <field name="amount_usados" widget="monetary" string="Medios de pago (Usados)" class="text-danger fw-semibold" options="{'currency_field': 'currency_id'}" invisible="amount_usados == 0"/>
                    <div class="oe_subtotal_footer_separator oe_inline o_td_label">
                        <label for="amount_saldo_cancelar" string="SALDO A CANCELAR"/>
                    </div>
                    <field name="amount_saldo_cancelar" nolabel="1" class="oe_subtotal_footer_separator fw-bold fs-4" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
