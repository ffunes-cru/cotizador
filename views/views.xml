<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Herencia de la vista de sale.order -->
    <record id="view_order_form_inherit_cotizador" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.cotizador</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- Redirigir el botón estándar de impresión de la cabecera a print_quotation -->
            <xpath expr="//header//button[@name='sale.action_report_saleorder']" position="attributes">
                <attribute name="name">print_quotation</attribute>
                <attribute name="type">object</attribute>
            </xpath>

            <!-- Orden de la cabecera (issue #3): Vista previa, Enviar, Imprimir, Generar Factura Proforma,
                 Confirmar Pedido, Cancelar. Odoo duplica Enviar, Proforma y Confirmar según el estado
                 (uno resaltado en borrador y otro en enviada): se ordenan los dos de cada par.
                 Habilitar / Revocar Firma del Cliente están en el menú de acciones (⚙). -->
            <xpath expr="//header/button[@id='quotation_send_primary']" position="before">
                <xpath expr="//header/button[@name='action_preview_sale_order']" position="move"/>
            </xpath>
            <xpath expr="//header/button[@id='quotation_send_primary']" position="after">
                <xpath expr="//header/button[@id='quotation_send']" position="move"/>
                <xpath expr="//header/button[@name='print_quotation']" position="move"/>
                <xpath expr="//header/button[@id='send_proforma_primary']" position="move"/>
                <xpath expr="//header/button[@id='send_proforma']" position="move"/>
                <xpath expr="//header/button[@id='action_confirm']" position="move"/>
                <xpath expr="//header/button[@name='action_confirm'][not(@id)]" position="move"/>
            </xpath>
            <xpath expr="//header/button[@id='send_proforma_primary']" position="attributes">
                <attribute name="string">Generar Factura Proforma</attribute>
            </xpath>
            <xpath expr="//header/button[@id='send_proforma']" position="attributes">
                <attribute name="string">Generar Factura Proforma</attribute>
            </xpath>
            <xpath expr="//header/button[@id='action_confirm']" position="attributes">
                <attribute name="string">Confirmar Pedido</attribute>
            </xpath>
            <xpath expr="//header/button[@name='action_confirm'][not(@id)]" position="attributes">
                <attribute name="string">Confirmar Pedido</attribute>
            </xpath>

            <!-- Botón Configurar en button_box -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_config_wizard" 
                        type="object" 
                        class="oe_stat_button" 
                        icon="fa-sliders"
                        invisible="state not in ('draft', 'sent')">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Configurar</span>
                    </div>
                </button>
                <button name="action_open_plan_pago_wizard" 
                        type="object" 
                        class="oe_stat_button" 
                        icon="fa-money"
                        invisible="state not in ('draft', 'sent')">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Planes de Pago</span>
                    </div>
                </button>
                <button name="action_ver_bcra_wizard" 
                        type="object" 
                        class="oe_stat_button" 
                        icon="fa-university"
                        invisible="not partner_id">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Situación BCRA</span>
                    </div>
                </button>
            </xpath>

            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="equipo_cotizado_id" options="{'no_create': True}"/>
                <!-- Concesionario: líder del equipo de ventas del vendedor (el vendedor queda en su lugar estándar) -->
                <field name="lider_equipo_id" widget="many2one_avatar_user"/>
            </xpath>

            <!-- Ocultar columna estándar de porcentaje de descuento en líneas para evitar conflictos con los descuentos en cascada -->
            <xpath expr="//field[@name='order_line']//list//field[@name='discount']" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>

            <!-- Cantidad (issue #3): la columna confunde cuando todo va de a 1. Se ve solo si alguna línea
                 tiene otra cantidad (p. ej. un sensor por línea), y en esa columna solo esas líneas. -->
            <xpath expr="//field[@name='order_line']//list//field[@name='product_uom_qty']" position="attributes">
                <attribute name="column_invisible">not parent.cotizador_muestra_cantidad</attribute>
                <attribute name="invisible">product_uom_qty == 1</attribute>
            </xpath>

            <!-- Ocultar botón nativo de Descuento flotante debajo de las líneas para unificar en 'Añadir Descuento' -->
            <xpath expr="//div[@name='so_button_below_order_lines']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- Interceptar "Add a product" en order_line para mostrar Cotizar Equipo, Añadir Equipo Usado y Añadir Descuento, resaltados en verde (Desktop) -->
            <xpath expr="//field[@name='order_line']//list//control" position="replace">
                <control>
                    <button name="action_open_config_wizard" 
                            type="object"
                            string="Cotizar Equipo"
                            class="btn-success o_cotizador_accion"
                            context="{'default_sale_order_id': parent.id, 'order_id': parent.id}"/>
                    <button name="action_open_equipo_usado_wizard" 
                            type="object"
                            string="Añadir Equipo Usado"
                            class="btn-success o_cotizador_accion"
                            context="{'default_sale_order_id': parent.id, 'order_id': parent.id}"/>
                    <button name="action_open_descuento_wizard" 
                            type="object"
                            string="Añadir Descuento"
                            class="btn-success o_cotizador_accion"
                            context="{'default_sale_order_id': parent.id, 'order_id': parent.id}"/>
                </control>
            </xpath>

            <!-- Interceptar controles de order_line en vista Kanban (Mobile) -->
            <xpath expr="//field[@name='order_line']//kanban//control" position="replace">
                <control>
                    <button name="action_open_config_wizard" 
                            type="object" 
                            string="Cotizar Equipo" 
                            class="btn-success" 
                            context="{'default_sale_order_id': parent.id, 'order_id': parent.id}"/>
                    <button name="action_open_equipo_usado_wizard" 
                            type="object" 
                            string="Añadir Equipo Usado" 
                            class="btn-success" 
                            context="{'default_sale_order_id': parent.id, 'order_id': parent.id}"/>
                    <button name="action_open_descuento_wizard" 
                            type="object" 
                            string="Añadir Descuento" 
                            class="btn-success" 
                            context="{'default_sale_order_id': parent.id, 'order_id': parent.id}"/>
                </control>
            </xpath>

            <!-- Pestaña Condiciones Generales y Planes de Pago -->
            <xpath expr="//notebook" position="inside">
                <page string="Condiciones y Planes de Pago" name="cotizador_terminos_planes">
                    <group>
                        <group string="Planes de Pago a Imprimir">
                            <p class="text-muted">
                                Tilde los planes de pago que van en la hoja de planes del PDF. Sin ninguno, el PDF no lleva esa hoja.
                            </p>
                            <!-- "Buscar más..." abre las opciones agrupadas por plantilla (issue #9); solo de plantillas activas -->
                            <field name="plan_pago_line_ids" widget="many2many_tags" options="{'no_create': True}" nolabel="1"
                                   domain="[('template_id.active', '=', True)]"
                                   context="{'search_default_agrupar_plantilla': 1}"/>
                        </group>
                        <group string="Condiciones Generales Constantes">
                            <p class="text-muted">
                                Texto constante que se imprime automáticamente en el pie de página de la cotización.
                            </p>
                            <field name="condiciones_generales" nolabel="1" widget="text" class="w-100"/>
                        </group>
                    </group>
                    <group string="Aceptación y Firma en el Portal Web">
                        <group>
                            <field name="portal_confirmation_mode" widget="radio"/>
                        </group>
                        <group invisible="portal_confirmation_mode != 'salesman_enables'">
                            <field name="portal_confirmation_allowed" widget="boolean_toggle"/>
                            <div class="text-muted small mt-2">
                                <i class="fa fa-info-circle me-1"/> Mientras este interruptor esté apagado, el cliente verá la cotización como una <strong>propuesta preliminar en revisión</strong> sin botón de firma. Al encenderlo (o usar <em>Habilitar Firma del Cliente</em> en el menú de acciones ⚙), el cliente podrá firmar y aceptar en la web.
                            </div>
                        </group>
                        <group invisible="portal_confirmation_mode != 'salesman_only'">
                            <div class="text-muted small">
                                <i class="fa fa-lock me-1" title="Bloqueado"/> <strong>Modo Solo Vendedor:</strong> El cliente nunca podrá firmar ni aceptar esta cotización online desde el portal. La venta debe ser confirmada internamente por la empresa / asesor.
                            </div>
                        </group>
                    </group>
                </page>
            </xpath>

            <!-- Totales: cascada del cotizador (ver sale.order._compute_totales_cotizador) -->
            <xpath expr="//group[@name='sale_total']" position="replace">
                <group class="oe_subtotal_footer oe_right" colspan="2" name="sale_total">
                    <field name="amount_subtotal_productos" widget="monetary" string="SUB TOTAL" options="{'currency_field': 'currency_id'}"/>
                    <field name="amount_descuentos" widget="monetary" string="Descuentos" class="text-danger fw-semibold" options="{'currency_field': 'currency_id'}" invisible="amount_descuentos == 0"/>
                    <field name="amount_plan_pago" widget="monetary" string="Plan de Pago" options="{'currency_field': 'currency_id'}" invisible="amount_plan_pago == 0"/>
                    <field name="amount_subtotal_neto" widget="monetary" string="SUB TOTAL NETO" class="fw-bold" options="{'currency_field': 'currency_id'}" invisible="amount_descuentos == 0 and amount_plan_pago == 0"/>
                    <field name="amount_iva_productos" widget="monetary" string="IVA" options="{'currency_field': 'currency_id'}"/>
                    <field name="amount_total_base" widget="monetary" string="TOTAL" class="fw-bold" options="{'currency_field': 'currency_id'}"/>
                    <field name="amount_usados" widget="monetary" string="Medios de pago (Usados)" class="text-danger fw-semibold" options="{'currency_field': 'currency_id'}" invisible="amount_usados == 0"/>
                    <div class="oe_subtotal_footer_separator oe_inline o_td_label">
                        <label for="amount_saldo_cancelar" string="SALDO A CANCELAR"/>
                    </div>
                    <field name="amount_saldo_cancelar" nolabel="1" class="oe_subtotal_footer_separator fw-bold fs-4" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Firma online del cliente (modo «Habilitado por el vendedor»): en el menú de acciones (⚙) del
         formulario, no en la cabecera (issue #3). El método valida estado y modo. -->
    <record id="action_server_enable_portal_confirmation" model="ir.actions.server">
        <field name="name">Habilitar Firma del Cliente</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_view_types">form</field>
        <field name="group_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
        <field name="state">code</field>
        <field name="code">record.action_enable_portal_confirmation()</field>
    </record>
    <record id="action_server_disable_portal_confirmation" model="ir.actions.server">
        <field name="name">Revocar Firma del Cliente</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_view_types">form</field>
        <field name="group_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
        <field name="state">code</field>
        <field name="code">record.action_disable_portal_confirmation()</field>
    </record>

    <!-- Buscar, filtrar y agrupar cotizaciones por concesionario (líder del equipo del vendedor) -->
    <record id="view_sales_order_filter_cotizador" model="ir.ui.view">
        <field name="name">sale.order.search.cotizador</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="lider_equipo_id"/>
            </xpath>
            <xpath expr="//search" position="inside">
                <filter name="group_by_concesionario" string="Concesionario" context="{'group_by': 'lider_equipo_id'}"/>
            </xpath>
        </field>
    </record>

    <record id="sale_order_tree_cotizador" model="ir.ui.view">
        <field name="name">sale.order.list.cotizador</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.sale_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="lider_equipo_id" widget="many2one_avatar_user" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
