<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="res_config_settings_view_form_cotizador" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.cotizador</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='sale_management']" position="inside">
                <block title="Cotizador de Sembradoras" name="cotizador_settings">
                    <setting id="cotizador_plan_pago_required_setting"
                             string="Plan de Pago Obligatorio"
                             help="Exigir la selección de un Plan de Pago antes de confirmar la cotización.">
                        <field name="cotizador_plan_pago_required"/>
                    </setting>
                    <setting id="cotizador_modo_silencioso_setting"
                             string="Modo Silencioso"
                             help="Oculta el precio unitario de los accesorios en el configurador, mostrando únicamente el precio total.">
                        <field name="cotizador_modo_silencioso"/>
                    </setting>
                    <setting id="cotizador_ecommerce_mode_setting"
                             string="Modo de la Tienda Online"
                             help="Define si la tienda online permite solicitar cotizaciones directamente al CRM o si opera como un eCommerce con checkout y cobro.">
                        <field name="cotizador_ecommerce_mode" widget="radio"/>
                    </setting>
                    <setting id="cotizador_pricing_setting"
                             string="Precios del Configurador"
                             help="Impuesto de máquinas y accesorios, y lista de precios de las cotizaciones de máquinas. La moneda de los precios de la matriz se define en cada producto (Moneda del Cotizador).">
                        <div class="row mt-2">
                            <label for="cotizador_tax_id" class="col-lg-5 o_light_label"/>
                            <field name="cotizador_tax_id" class="col-lg-6" options="{'no_create': True}"/>
                        </div>
                        <div class="row">
                            <label for="cotizador_pricelist_id" class="col-lg-5 o_light_label"/>
                            <field name="cotizador_pricelist_id" class="col-lg-6" options="{'no_create': True}"/>
                        </div>
                    </setting>
                    <setting id="cotizador_quote_protection_setting"
                             string="Protección del Formulario de Solicitud Web"
                             help="Límites por hora para solicitudes anónimas (0 = sin límite) y tiempo mínimo de llenado.">
                        <field name="cotizador_captcha_configured" invisible="1"/>
                        <div class="alert alert-warning mt-2 mb-2" role="alert" invisible="cotizador_captcha_configured">
                            Sin captcha configurado: configure reCAPTCHA o Cloudflare Turnstile en Ajustes del Sitio Web.
                            El formulario lo usa automáticamente.
                        </div>
                        <div class="row mt-2">
                            <label for="cotizador_quote_rate_limit_ip" class="col-lg-6 o_light_label"/>
                            <field name="cotizador_quote_rate_limit_ip" class="col-lg-2"/>
                        </div>
                        <div class="row">
                            <label for="cotizador_quote_rate_limit_contact" class="col-lg-6 o_light_label"/>
                            <field name="cotizador_quote_rate_limit_contact" class="col-lg-2"/>
                        </div>
                        <div class="row">
                            <label for="cotizador_quote_min_seconds" class="col-lg-6 o_light_label"/>
                            <field name="cotizador_quote_min_seconds" class="col-lg-2"/>
                        </div>
                    </setting>
                    <setting id="cotizador_portal_confirmation_mode_setting"
                             string="Aceptación de Cotizaciones en el Portal"
                             help="Define cómo interactúa el cliente con la cotización en la web: estándar de Odoo, habilitada puntualmente por el vendedor, o solo confirmada internamente.">
                        <field name="cotizador_portal_confirmation_mode" widget="radio"/>
                    </setting>
                    <setting id="cotizador_condiciones_generales_default_setting"
                             string="Condiciones Generales Predeterminadas"
                             help="Texto comercial constante que aparecerá automáticamente en todas las nuevas cotizaciones y al pie de su reporte PDF.">
                        <field name="cotizador_condiciones_generales_default" widget="text" class="w-100"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
