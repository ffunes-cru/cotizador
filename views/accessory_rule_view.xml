<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Vista form de Regla de Accesorio -->
    <record id="view_sembradora_accessory_rule_form" model="ir.ui.view">
        <field name="name">sembradora.accessory.rule.form</field>
        <field name="model">sembradora.accessory.rule</field>
        <field name="arch" type="xml">
            <form string="Regla de Exclusión/Inclusión">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="rule_type"/>
                        </group>
                        <group>
                            <field name="description"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vista lista de Regla de Accesorio -->
    <record id="view_sembradora_accessory_rule_list" model="ir.ui.view">
        <field name="name">sembradora.accessory.rule.list</field>
        <field name="model">sembradora.accessory.rule</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="rule_type"/>
                <field name="description"/>
            </list>
        </field>
    </record>

    <!-- Acción -->
    <record id="action_sembradora_accessory_rule" model="ir.actions.act_window">
        <field name="name">Reglas de Exclusión/Inclusión</field>
        <field name="res_model">sembradora.accessory.rule</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menú -->
    <menuitem id="menu_sembradora_accessory_rule"
              groups="cotizador.group_cotizador_manager"
              name="Reglas de Accesorios"
              parent="menu_sembradora_config_root"
              sequence="25"
              action="action_sembradora_accessory_rule"/>
</odoo>
