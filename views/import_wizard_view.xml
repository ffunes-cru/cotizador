<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Vista form del wizard de importación -->
    <record id="view_sembradora_import_wizard_form" model="ir.ui.view">
        <field name="name">sembradora.import.wizard.form</field>
        <field name="model">sembradora.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Importar Configuraciones">
                <header>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,analyzed,done"/>
                </header>
                <sheet>
                    <!-- Paso 1: Carga de CSVs -->
                    <group invisible="state != 'draft'" string="Cargar Archivos" name="upload">
                        <group name="upload_files">
                            <field name="csv_file_ids" widget="many2many_binary" string="Archivos CSV o Excel"/>
                            <field name="currency_id" options="{'no_create': True}"/>
                        </group>
                    </group>
                    <group invisible="state != 'draft' or not sheet_ids" string="Hojas a importar" name="sheets">
                        <div class="text-muted" colspan="2">
                            Cada máquina importada queda igual a su hoja: marque solo las hojas con las
                            configuraciones a cargar (no las copias ni las exportaciones).
                        </div>
                        <field name="sheet_ids" nolabel="1" colspan="2">
                            <list editable="bottom" create="0" delete="0">
                                <field name="sequence" column_invisible="1"/>
                                <field name="selected" widget="boolean_toggle"/>
                                <!-- force_save: el cliente no manda campos de solo lectura de líneas nuevas -->
                                <field name="name" force_save="1"/>
                                <field name="source" force_save="1"/>
                            </list>
                        </field>
                    </group>

                    <!-- Resultado del análisis / Resumen final -->
                    <group invisible="state == 'draft'" string="Resultado">
                        <field name="normalized_csv" filename="normalized_csv_name" invisible="not normalized_csv"
                               string="Matriz leída (CSV)"/>
                        <field name="normalized_csv_name" invisible="1"/>
                        <field name="analysis_summary" nolabel="1" colspan="2"/>
                        <field name="has_errors" invisible="1"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_analyze"
                            string="📊 Analizar"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_import"
                            string="📥 Importar"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'analyzed' or has_errors"/>
                    <button name="action_back_to_upload"
                            string="Cargar otros archivos"
                            type="object"
                            class="btn-secondary"
                            invisible="state != 'analyzed'"/>
                    <button string="Cerrar"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Acción para abrir el wizard -->
    <record id="action_sembradora_import_wizard" model="ir.actions.act_window">
        <field name="name">Importar Configuraciones CSV</field>
        <field name="res_model">sembradora.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Menú bajo Configurador Sembradoras -->
    <menuitem id="menu_sembradora_import_wizard"
              groups="cotizador.group_cotizador_manager"
              name="Importar Configuraciones"
              parent="menu_sembradora_config_root"
              sequence="30"
              action="action_sembradora_import_wizard"/>
</odoo>
