<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Vista form del wizard de importación -->
    <record id="view_sembradora_import_wizard_form" model="ir.ui.view">
        <field name="name">sembradora.import.wizard.form</field>
        <field name="model">sembradora.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Importar Configuraciones desde CSV">
                <header>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,analyzed,done"/>
                </header>
                <sheet>
                    <!-- Paso 1: Carga de CSVs -->
                    <group invisible="state != 'draft'" string="Cargar Archivos CSV">
                        <group>
                            <field name="csv_file_ids" widget="many2many_binary" string="Archivos CSV"/>
                        </group>
                    </group>

                    <!-- Opciones de creación automática -->
                    <group invisible="state != 'analyzed'" string="Opciones de Creación Automática">
                        <group>
                            <field name="create_missing_products"/>
                            <field name="create_missing_attributes"/>
                            <field name="create_missing_categories"/>
                        </group>
                    </group>

                    <!-- Resultado del análisis / Resumen final -->
                    <group invisible="state == 'draft'" string="Resultado">
                        <field name="analysis_summary" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_analyze"
                            string="📊 Analizar CSV"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_import"
                            string="📥 Importar"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'analyzed'"/>
                    <button string="Cerrar"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Acción para abrir el wizard -->
    <record id="action_sembradora_import_wizard" model="ir.actions.act_window">
        <field name="name">Importar Configuraciones CSV</field>
        <field name="res_model">sembradora.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Menú bajo Configurador Sembradoras -->
    <menuitem id="menu_sembradora_import_wizard"
              name="Importar Configuraciones"
              parent="menu_sembradora_config_root"
              sequence="30"
              action="action_sembradora_import_wizard"/>
</odoo>
