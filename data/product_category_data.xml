<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Máquinas configurables: product.template.is_maquina = categoría hija de esta -->
        <record id="cat_maquina" model="product.category">
            <field name="name">Máquina</field>
        </record>

        <!-- Accesorios: product.template.is_accesorio = categoría hija de esta. Las subcategorías
             de cantidad dinámica las crea el importador (una por atributo de Calc_param). -->
        <record id="cat_accesorio_base" model="product.category">
            <field name="name">Accesorio</field>
        </record>
    </data>
</odoo>
